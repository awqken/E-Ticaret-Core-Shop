@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    string ActiveWhen(string controller, string action) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CoreShop Admin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-body">

    <aside class="admin-sidebar">
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="admin-brand">
            <i class="fa-solid fa-microchip" aria-hidden="true"></i>
            <span>CoreShop Admin</span>
        </a>

        <div class="sidebar-title">Genel</div>

        <a asp-area="Admin" asp-controller="Home" asp-action="Index"
           class="sidebar-link @ActiveWhen("Home", "Index")">
            <i class="fa-solid fa-gauge-high" aria-hidden="true"></i>
            <span>Dashboard</span>
        </a>

        <div class="sidebar-title">Katalog</div>

        <a asp-area="Admin" asp-controller="Product" asp-action="List"
           class="sidebar-link @ActiveWhen("Product", "List")">
            <i class="fa-solid fa-box-open" aria-hidden="true"></i>
            <span>Ürünler</span>
        </a>

        <a asp-area="Admin" asp-controller="Product" asp-action="Create"
           class="sidebar-link @ActiveWhen("Product", "Create")">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            <span>Ürün Ekle</span>
        </a>

        <a asp-area="Admin" asp-controller="Category" asp-action="List"
           class="sidebar-link @ActiveWhen("Category", "List")">
            <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
            <span>Kategoriler</span>
        </a>

        <a asp-area="Admin" asp-controller="Category" asp-action="Create"
           class="sidebar-link @ActiveWhen("Category", "Create")">
            <i class="fa-solid fa-folder-plus" aria-hidden="true"></i>
            <span>Kategori Ekle</span>
        </a>

        <div class="sidebar-title">Satış</div>

        <a asp-area="Admin" asp-controller="Order" asp-action="List"
           class="sidebar-link @ActiveWhen("Order", "List")">
            <i class="fa-solid fa-receipt" aria-hidden="true"></i>
            <span>Siparişler</span>
        </a>

        <div class="mt-auto pt-3">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="sidebar-link">
                <i class="fa-solid fa-store" aria-hidden="true"></i>
                <span>Mağazaya Dön</span>
            </a>
        </div>
    </aside>

    <div class="admin-main">
        <header class="admin-topbar">
            <div>
                <p class="topbar-title">@ViewData["Title"]</p>
                <p class="topbar-sub">CoreShop yönetim paneli</p>
            </div>

            <div class="admin-user-chip">
                <i class="fa-solid fa-user-shield me-2" aria-hidden="true"></i> @User.Identity?.Name
            </div>
        </header>

        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    <partial name="_Toasts" />

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
