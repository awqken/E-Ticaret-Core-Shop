@model List<CoreShop.MODEL.Entities.Order>

@{
    ViewData["Title"] = "Sipariş Yönetimi";
    Layout = "~/Areas/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

            <div>
                <h2 class="fw-bold mb-1">Sipariş Yönetimi</h2>
                <small class="text-muted">
                    Toplam Sipariş: @Model.Count
                </small>
            </div>

            <form method="get" class="d-flex gap-2">
                <input type="number"
                       name="searchId"
                       class="form-control"
                       placeholder="Sipariş No Ara" />

                <button class="btn btn-dark">
                    Ara
                </button>
            </form>

        </div>

    </div>

    <div class="row g-4">

        @foreach (var item in Model)
        {
            <div class="col-lg-6">

                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 order-card">

                    <div class="d-flex justify-content-between mb-3">

                        <div>
                            <h5 class="fw-bold mb-1">
                                Sipariş #@item.ID
                            </h5>

                            <small class="text-muted">
                                @item.OrderDate.ToString("dd.MM.yyyy")
                            </small>
                        </div>

                        <div class="fw-bold fs-5">
                            ₺@item.TotalPrice.ToString("N2")
                        </div>

                    </div>

                    <div class="mb-3">
                        <strong>@item.FullName</strong><br />
                        <small class="text-muted">
                            @item.City / @item.District
                        </small>
                    </div>

                    <div class="mb-3">
                        <partial name="_OrderStatusBadge" model="item.Status" />
                    </div>

                    @if (item.Status.IsFinal())
                    {
                        <div class="d-flex gap-2">

                            <select class="form-select" disabled>
                                <option>@item.Status.ToDisplayName()</option>
                            </select>

                            <button class="btn btn-secondary" disabled>
                                Kilitli
                            </button>

                        </div>
                    }
                    else
                    {
                        <form method="post"
                              asp-area="Admin"
                              asp-controller="Order"
                              asp-action="UpdateStatus">

                            <input type="hidden"
                                   name="id"
                                   value="@item.ID" />

                            <div class="d-flex gap-2">

                                <select name="status" class="form-select">

                                    <option selected disabled>
                                        @item.Status.ToDisplayName()
                                    </option>

                                    @foreach (var target in item.Status.GetAllowedTransitions())
                                    {
                                        <option value="@target">
                                            @target.ToDisplayName()
                                        </option>
                                    }

                                </select>

                                <button class="btn btn-dark">
                                    Kaydet
                                </button>

                            </div>

                        </form>
                    }

                    <div class="mt-3 d-flex gap-2">
                        <a asp-area="Admin"
                           asp-controller="Order"
                           asp-action="Detail"
                           asp-route-id="@item.ID"
                           class="btn btn-outline-dark">
                            Detay
                        </a>
                    </div>

                </div>

            </div>
        }

    </div>

</div>

<style>
    .order-card {
        transition: .2s;
    }

        .order-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 35px rgba(0,0,0,.08) !important;
        }
</style>