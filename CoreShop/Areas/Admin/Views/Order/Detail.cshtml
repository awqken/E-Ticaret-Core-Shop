@model CoreShop.Areas.Models.AdminOrderDetailVM

@{
    ViewData["Title"] = "Sipariş Detayı";
    Layout = "~/Areas/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="admin-page-head mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2 class="h4 mb-1">
                    <i class="fa-solid fa-receipt me-2" aria-hidden="true"></i> Sipariş #@Model.Order.ID
                </h2>
                <p>@Model.Order.OrderDate.ToString("dd.MM.yyyy HH:mm")</p>
            </div>

            <a asp-area="Admin" asp-controller="Order" asp-action="List" class="btn btn-light fw-semibold px-4">
                <i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i> Siparişlere Dön
            </a>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-lg-8">
            <div class="surface p-4">
                <h2 class="h5 fw-bold mb-3">Sipariş Ürünleri</h2>

                @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                {
                    @foreach (var item in Model.OrderDetails)
                    {
                        <div class="order-line">
                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrEmpty(item.ProductImage))
                                {
                                    <img src="~/images/@item.ProductImage"
                                         alt="@item.ProductName"
                                         loading="lazy"
                                         width="56" height="56"
                                         class="order-line-thumb"
                                         onerror="this.onerror=null;this.src='/images/products/default.svg';" />
                                }
                                else
                                {
                                    <div class="order-line-thumb" aria-label="Görsel yok">
                                        <i class="fa-solid fa-image text-muted" aria-hidden="true"></i>
                                    </div>
                                }

                                <div>
                                    <div class="fw-semibold">@item.ProductName</div>
                                    <small class="text-muted">Adet: @item.Quantity</small>
                                </div>
                            </div>

                            <div class="fw-bold">@item.UnitPrice.ToTryPrice()</div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                        </div>
                        <h4>Sipariş ürünü bulunamadı</h4>
                        <p>Bu siparişe ait ürün kaydı yok.</p>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">

            <div class="surface p-4 mb-4">
                <h2 class="h5 fw-bold mb-3">Sipariş Bilgisi</h2>

                <div class="mb-3">
                    <small class="text-muted d-block mb-1">Durum</small>
                    <partial name="_OrderStatusBadge" model="Model.Order.Status" />
                </div>

                <div>
                    <small class="text-muted d-block">Toplam Tutar</small>
                    <div class="fw-bold fs-5">@Model.Order.TotalPrice.ToTryPrice()</div>
                </div>
            </div>

            <div class="surface p-4 mb-4">
                <h2 class="h5 fw-bold mb-3">Teslimat Bilgisi</h2>

                <div class="mb-2 fw-semibold">@Model.Order.FullName</div>
                <div class="text-muted mb-1">
                    <i class="fa-solid fa-phone me-2" aria-hidden="true"></i>@Model.Order.PhoneNumber
                </div>
                <div class="text-muted mb-1">
                    <i class="fa-solid fa-location-dot me-2" aria-hidden="true"></i>@Model.Order.City / @Model.Order.District
                </div>
                <div class="text-muted">@Model.Order.FullAddress</div>
            </div>

            <div class="surface p-4">
                <h2 class="h5 fw-bold mb-3">Ödeme Bilgisi</h2>

                <div class="mb-2">
                    <small class="text-muted d-block">Kart Üzerindeki İsim</small>
                    <div>@Model.Order.CardName</div>
                </div>

                <div>
                    <small class="text-muted d-block">Kart</small>
                    <div>**** **** **** @Model.Order.CardLast4</div>
                </div>
            </div>

        </div>

    </div>
</div>
