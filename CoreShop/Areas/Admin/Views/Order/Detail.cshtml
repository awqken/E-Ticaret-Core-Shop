@model CoreShop.Areas.Models.AdminOrderDetailVM

@{
    ViewData["Title"] = "Sipariş Detayı";
    Layout = "~/Areas/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Sipariş #@Model.Order.ID</h2>
            <small class="text-muted">
                @Model.Order.OrderDate.ToString("dd.MM.yyyy HH:mm")
            </small>
        </div>

        <a href="/Admin/Order/List" class="btn btn-outline-dark rounded-3">
            Geri Dön
        </a>
    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h4 class="fw-bold mb-4">Sipariş Ürünleri</h4>

                @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                {
                    @foreach (var item in Model.OrderDetails)
                    {
                        <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                            <div class="d-flex align-items-center gap-3">
                                <img src="/images/@item.ProductImage"
                                     width="65"
                                     height="65"
                                     class="rounded-3 border"
                                     style="object-fit:cover;" />

                                <div>
                                    <div class="fw-semibold">@item.ProductName</div>
                                    <small class="text-muted">
                                        Adet: @item.Quantity
                                    </small>
                                </div>
                            </div>

                            <div class="fw-bold">
                                ₺@item.UnitPrice.ToString("N2")
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted">Sipariş ürünü bulunamadı.</div>
                }
            </div>

        </div>

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-3">Sipariş Bilgisi</h5>

                <div class="mb-3">
                    <small class="text-muted d-block">Durum</small>

                    <partial name="_OrderStatusBadge" model="Model.Order.Status" />
                </div>

                <div class="mb-3">
                    <small class="text-muted d-block">Toplam Tutar</small>
                    <div class="fw-bold fs-5">
                        ₺@Model.Order.TotalPrice.ToString("N2")
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-3">Teslimat Bilgisi</h5>

                <div class="mb-2"><strong>@Model.Order.FullName</strong></div>
                <div class="text-muted mb-1">@Model.Order.PhoneNumber</div>
                <div class="text-muted mb-1">@Model.Order.City / @Model.Order.District</div>
                <div class="text-muted">@Model.Order.FullAddress</div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-3">Ödeme Bilgisi</h5>

                <div class="mb-2">
                    <small class="text-muted d-block">Kart Üzerindeki İsim</small>
                    <div>@Model.Order.CardName</div>
                </div>

                <div>
                    <small class="text-muted d-block">Kart</small>
                    <div>**** **** **** @Model.Order.CardLast4</div>
                </div>
            </div>

        </div>

    </div>
</div>