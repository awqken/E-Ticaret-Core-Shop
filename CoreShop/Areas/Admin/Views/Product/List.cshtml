@model List<CoreShop.MODEL.Entities.Product>

@{
    ViewData["Title"] = "Ürünler";
    Layout = "~/Areas/Shared/_AdminLayout.cshtml";
    var currentSort = ViewBag.Sort as string;
    var currentSearch = ViewBag.Search as string;
}

<div class="container-fluid">
    <div class="admin-page-head mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2 class="h4 mb-1">
                    <i class="fa-solid fa-box-open me-2" aria-hidden="true"></i> Ürün Yönetimi
                </h2>
                <p>Sistemde kayıtlı @Model.Count ürünü görüntüleyebilir ve yönetebilirsin.</p>
            </div>

            <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn btn-light fw-semibold px-4">
                <i class="fa-solid fa-plus me-2" aria-hidden="true"></i> Yeni Ürün Ekle
            </a>
        </div>
    </div>

    <div class="d-flex gap-3 align-items-start flex-wrap mb-4">

        <form method="get" class="d-flex gap-2 align-items-center" role="search" aria-label="Ürün ara">
            <input type="hidden" name="sort" value="@currentSort" />

            <input type="search"
                   name="search"
                   value="@currentSearch"
                   class="form-control field-w-lg"
                   placeholder="Ürün, marka veya kategori ara..."
                   aria-label="Ürün ara"
                   />

            <button type="submit" class="btn btn-dark px-4">
                Ara
            </button>

            <a asp-area="Admin" asp-controller="Product" asp-action="List" class="btn btn-soft px-4">
                Temizle
            </a>
        </form>

        <form method="get" aria-label="Sıralama">
            <input type="hidden" name="search" value="@currentSearch" />
            <select name="sort"
                    class="form-select field-w-md"

                    onchange="this.form.submit()"
                    aria-label="Sıralama seç">

                <option value="" selected="@string.IsNullOrEmpty(currentSort)">Varsayılan</option>
                <option value="new" selected="@(currentSort == "new")">En Yeni</option>
                <option value="price_asc" selected="@(currentSort == "price_asc")">Fiyat Artan</option>
                <option value="price_desc" selected="@(currentSort == "price_desc")">Fiyat Azalan</option>
                <option value="stock_desc" selected="@(currentSort == "stock_desc")">Stok Fazla</option>
                <option value="stock_asc" selected="@(currentSort == "stock_asc")">Stok Az</option>
                <option value="low_stock" selected="@(currentSort == "low_stock")">Kritik Stok</option>
                <option value="out_stock" selected="@(currentSort == "out_stock")">Tükenenler</option>
            </select>
        </form>

    </div>

    <div class="surface p-4">
        @if (Model.Count > 0)
        {
            <div class="table-responsive">
                <table class="table align-middle table-hover data-table">
                    <thead>
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Görsel</th>
                            <th scope="col">Ürün Adı</th>
                            <th scope="col">Marka</th>
                            <th scope="col">Fiyat</th>
                            <th scope="col">Stok</th>
                            <th scope="col">Kategori</th>
                            <th scope="col">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge badge-soft-neutral px-3 py-2 rounded-pill">
                                        @item.ID
                                    </span>
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(item.ProductImage))
                                    {
                                        <img src="~/images/@item.ProductImage"
                                             alt="@item.ProductName"
                                             loading="lazy"
                                             width="60" height="60"
                                             class="table-thumb" />
                                    }
                                    else
                                    {
                                        <div class="table-thumb-empty" aria-label="Görsel yok">
                                            <i class="fa-solid fa-image" aria-hidden="true"></i>
                                        </div>
                                    }
                                </td>

                                <td class="fw-semibold">@item.ProductName</td>

                                <td>
                                    <span class="badge badge-soft-info px-3 py-2 rounded-pill">
                                        @item.ProductBrand
                                    </span>
                                </td>

                                <td class="fw-semibold">
                                    @item.ProductPrice.ToTryPrice()
                                </td>

                                <td>
                                    @if (item.ProductStock > 5)
                                    {
                                        <span class="badge badge-soft-success px-3 py-2 rounded-pill">
                                            @item.ProductStock
                                        </span>
                                    }
                                    else if (item.ProductStock > 0)
                                    {
                                        <span class="badge badge-soft-warning px-3 py-2 rounded-pill">
                                            @item.ProductStock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-danger px-3 py-2 rounded-pill">
                                            Stok Yok
                                        </span>
                                    }
                                </td>

                                <td>
                                    @{
                                        var categories = ViewBag.Categories as List<CoreShop.MODEL.Entities.Category>;
                                        var categoryName = categories?
                                            .FirstOrDefault(x => x.ID == item.CategoryId)?
                                            .CategoryName;
                                    }

                                    <span class="badge badge-soft-neutral px-3 py-2 rounded-pill">
                                        @(categoryName ?? "Kategori Yok")
                                    </span>
                                </td>

                                <td>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <a asp-area="Admin" asp-controller="Product" asp-action="Update" asp-route-id="@item.ID"
                                           class="btn btn-sm btn-outline-primary px-3">
                                            <i class="fa-solid fa-pen-to-square me-1" aria-hidden="true"></i> Düzenle
                                        </a>

                                        <button type="button"
                                                onclick="confirmProductDelete(@item.ID)"
                                                class="btn btn-sm btn-outline-danger px-3">
                                            <i class="fa-solid fa-trash me-1" aria-hidden="true"></i> Sil
                                        </button>

                                        <form asp-area="Admin" asp-controller="Product" asp-action="Delete" asp-route-id="@item.ID"
                                              method="post" id="deleteProductForm_@item.ID" class="d-none"></form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                </div>
                <h4>Ürün bulunamadı</h4>
                <p>Bu aramaya uyan ürün yok ya da henüz ürün eklenmemiş.</p>
                <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn btn-brand">
                    <i class="fa-solid fa-plus me-2" aria-hidden="true"></i> İlk Ürünü Ekle
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function confirmProductDelete(id) {
            Swal.fire({
                title: 'Emin misin?',
                text: "Bu ürünü silmek istediğine emin misin?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Evet, sil',
                cancelButtonText: 'Vazgeç',
                confirmButtonColor: '#d92d20',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteProductForm_' + id).submit();
                }
            });
        }
    </script>
}
