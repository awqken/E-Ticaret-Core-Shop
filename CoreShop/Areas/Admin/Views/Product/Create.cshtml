@model CoreShop.Areas.Models.ProductFormVM

@{
    ViewData["Title"] = "Ürün Ekle";
    Layout = "~/Areas/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="admin-page-head mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2 class="h4 mb-1">
                    <i class="fa-solid fa-plus me-2" aria-hidden="true"></i> Yeni Ürün Ekle
                </h2>
                <p>CoreShop kataloğuna yeni bir ürün eklemek için formu doldur.</p>
            </div>

            <a asp-area="Admin" asp-controller="Product" asp-action="List" class="btn btn-light fw-semibold px-4">
                <i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i> Ürün Listesi
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="surface p-4">
                <h2 class="h5 fw-bold mb-4">
                    <i class="fa-solid fa-box-open text-brand me-2" aria-hidden="true"></i> Ürün Bilgileri
                </h2>

                <form asp-area="Admin" asp-controller="Product" asp-action="Create" method="post" enctype="multipart/form-data" novalidate>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <label asp-for="ProductName" class="form-label fw-semibold">Ürün Adı</label>
                            <input asp-for="ProductName" class="form-control" placeholder="Örn: RTX 4060 Ekran Kartı" />
                            <span asp-validation-for="ProductName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ProductBrand" class="form-label fw-semibold">Marka</label>
                            <input asp-for="ProductBrand" class="form-control" placeholder="Örn: ASUS" />
                            <span asp-validation-for="ProductBrand" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ProductPrice" class="form-label fw-semibold">Fiyat (₺)</label>
                            <input asp-for="ProductPrice" class="form-control" placeholder="Örn: 12499" inputmode="decimal" />
                            <span asp-validation-for="ProductPrice" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ProductStock" class="form-label fw-semibold">Stok</label>
                            <input asp-for="ProductStock" class="form-control" placeholder="Örn: 15" inputmode="numeric" />
                            <span asp-validation-for="ProductStock" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-semibold">Kategori</label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                                <option value="">Kategori Seçiniz</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ImageFile" class="form-label fw-semibold">Ürün Görseli</label>
                            <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                            <div class="form-text">JPG, PNG veya WebP — en fazla 2 MB.</div>
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold">Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Ürün hakkında kısa açıklama giriniz..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12 d-flex gap-3 mt-4">
                            <button type="submit" class="btn btn-brand px-4">
                                <i class="fa-solid fa-floppy-disk me-2" aria-hidden="true"></i> Kaydet
                            </button>

                            <a asp-area="Admin" asp-controller="Product" asp-action="List" class="btn btn-soft px-4">
                                Vazgeç
                            </a>
                        </div>

                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="surface p-4 h-100">
                <h2 class="h5 fw-bold mb-3">
                    <i class="fa-solid fa-circle-info text-brand me-2" aria-hidden="true"></i> Bilgilendirme
                </h2>

                <div class="info-box mb-3">
                    <i class="fa-solid fa-check text-success me-2" aria-hidden="true"></i>
                    Ürün adı açık ve net olmalı.
                </div>

                <div class="info-box mb-3">
                    <i class="fa-solid fa-check text-success me-2" aria-hidden="true"></i>
                    Görsel bilgisayardan seçilerek yüklenir.
                </div>

                <div class="info-box mb-3">
                    <i class="fa-solid fa-check text-success me-2" aria-hidden="true"></i>
                    Kategori listeden seçilir.
                </div>

                <div class="info-box">
                    <i class="fa-solid fa-check text-success me-2" aria-hidden="true"></i>
                    Kaydettikten sonra ürün mağazada anında görünür.
                </div>
            </div>
        </div>
    </div>
</div>
