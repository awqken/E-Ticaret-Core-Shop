@model CoreShop.MODEL.Entities.Product

@{
    ViewData["Title"] = "Ürün Ekle";
    Layout = "~/Areas/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 p-4" style="background: linear-gradient(135deg, #2563eb, #1d4ed8); color: white;">
                <div class="d-flex justify-content-between align-items-center flex-wrap">
                    <div>
                        <h2 class="fw-bold mb-2">
                            <i class="fa-solid fa-plus me-2"></i> Yeni Ürün Ekle
                        </h2>
                        <p class="mb-0 fs-6 text-light">
                            CoreShop sistemine yeni ürün eklemek için aşağıdaki formu doldur.
                        </p>
                    </div>

                    <div class="mt-3 mt-md-0">
                        <a href="/Admin/Product/List" class="btn btn-light rounded-3 px-4 fw-semibold">
                            <i class="fa-solid fa-arrow-left me-2"></i> Ürün Listesi
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 px-4 pt-4 pb-2">
                    <h5 class="fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-box text-primary"></i>
                        Ürün Bilgileri
                    </h5>
                </div>

                <div class="card-body px-4 pb-4">
                    <form asp-area="Admin" asp-controller="Product" asp-action="Create" method="post" enctype="multipart/form-data">

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="row g-4">

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Ürün Adı</label>
                                <input asp-for="ProductName" class="form-control custom-input" placeholder="Örn: RTX 4060 Ekran Kartı" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Marka</label>
                                <input asp-for="ProductBrand" class="form-control custom-input" placeholder="Örn: ASUS" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Fiyat</label>
                                <input asp-for="ProductPrice" class="form-control custom-input" placeholder="Örn: 12499" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Stok</label>
                                <input asp-for="ProductStock" class="form-control custom-input" placeholder="Örn: 15" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Kategori</label>
                                <select asp-for="CategoryId" class="form-select custom-input" asp-items="ViewBag.Categories">
                                    <option value="">Kategori Seçiniz</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Ürün Görseli</label>
                                <input type="file" name="ImageFile" class="form-control custom-input" />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Açıklama</label>
                                <textarea asp-for="Description" class="form-control custom-input" rows="4" placeholder="Ürün hakkında kısa açıklama giriniz..."></textarea>
                            </div>

                            <div class="col-12 d-flex gap-3 mt-4">
                                <button type="submit" class="btn btn-primary rounded-3 px-4 py-2 fw-semibold">
                                    <i class="fa-solid fa-floppy-disk me-2"></i> Kaydet
                                </button>

                                <a href="/Admin/Product/List" class="btn btn-outline-secondary rounded-3 px-4 py-2 fw-semibold">
                                    Vazgeç
                                </a>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-4 mt-4 mt-lg-0">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 px-4 pt-4 pb-2">
                    <h5 class="fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-info text-primary"></i>
                        Bilgilendirme
                    </h5>
                </div>

                <div class="card-body px-4 pb-4">
                    <div class="info-box mb-3">
                        <i class="fa-solid fa-check text-success me-2"></i>
                        Ürün adı açık ve net olmalı.
                    </div>

                    <div class="info-box mb-3">
                        <i class="fa-solid fa-check text-success me-2"></i>
                        Görsel bilgisayardan seçilerek yüklenir.
                    </div>

                    <div class="info-box mb-3">
                        <i class="fa-solid fa-check text-success me-2"></i>
                        Kategori artık listeden seçilir.
                    </div>

                    <div class="info-box">
                        <i class="fa-solid fa-check text-success me-2"></i>
                        Kaydet butonuna basınca ürün listeye düşer.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-input {
        border-radius: 14px;
        padding: 12px 14px;
        border: 1px solid #dbe2ea;
        transition: 0.2s ease;
    }

        .custom-input:focus {
            box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.15);
            border-color: #2563eb;
        }

    .info-box {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 14px 16px;
        color: #334155;
    }
</style>