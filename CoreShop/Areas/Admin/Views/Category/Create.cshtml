@model CoreShop.Areas.Models.CategoryFormVM

@{
    ViewData["Title"] = "Kategori Ekle";
    Layout = "~/Areas/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="admin-page-head mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2 class="h4 mb-1">
                    <i class="fa-solid fa-folder-plus me-2" aria-hidden="true"></i> Yeni Kategori Ekle
                </h2>
                <p>CoreShop kataloğuna yeni bir kategori eklemek için alanları doldur.</p>
            </div>

            <a asp-area="Admin" asp-controller="Category" asp-action="List" class="btn btn-light fw-semibold px-4">
                <i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i> Kategori Listesi
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="surface p-4">
                <h2 class="h5 fw-bold mb-4">
                    <i class="fa-solid fa-folder-open text-brand me-2" aria-hidden="true"></i> Kategori Bilgileri
                </h2>

                <form asp-area="Admin" asp-controller="Category" asp-action="Create" method="post" novalidate>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-4">

                        <div class="col-12">
                            <label asp-for="CategoryName" class="form-label fw-semibold">Kategori Adı</label>
                            <input asp-for="CategoryName" class="form-control" placeholder="Örn: Ekran Kartı" />
                            <span asp-validation-for="CategoryName" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold">Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="5" placeholder="Kategori hakkında kısa açıklama giriniz..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12 d-flex gap-3 mt-4">
                            <button type="submit" class="btn btn-brand px-4">
                                <i class="fa-solid fa-floppy-disk me-2" aria-hidden="true"></i> Kaydet
                            </button>

                            <a asp-area="Admin" asp-controller="Category" asp-action="List" class="btn btn-soft px-4">
                                Vazgeç
                            </a>
                        </div>

                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="surface p-4 h-100">
                <h2 class="h5 fw-bold mb-3">
                    <i class="fa-solid fa-circle-info text-brand me-2" aria-hidden="true"></i> Bilgilendirme
                </h2>

                <div class="info-box mb-3">
                    <i class="fa-solid fa-check text-success me-2" aria-hidden="true"></i>
                    Kategori adı kısa ve net olmalı.
                </div>

                <div class="info-box mb-3">
                    <i class="fa-solid fa-check text-success me-2" aria-hidden="true"></i>
                    Örnek kategori isimleri: RAM, SSD, Anakart, İşlemci
                </div>

                <div class="info-box">
                    <i class="fa-solid fa-check text-success me-2" aria-hidden="true"></i>
                    Eklenen kategoriler ürün ekleme ekranında otomatik görünür.
                </div>
            </div>
        </div>
    </div>
</div>
