@model List<CoreShop.MODEL.Entities.Category>

@{
    ViewData["Title"] = "Kategoriler";
    Layout = "~/Areas/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="admin-page-head mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2 class="h4 mb-1">
                    <i class="fa-solid fa-folder-open me-2" aria-hidden="true"></i> Kategori Yönetimi
                </h2>
                <p>Sistemde kayıtlı @Model.Count kategoriyi bu ekrandan yönetebilirsin.</p>
            </div>

            <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="btn btn-light fw-semibold px-4">
                <i class="fa-solid fa-plus me-2" aria-hidden="true"></i> Yeni Kategori Ekle
            </a>
        </div>
    </div>

    <div class="surface p-4">
        @if (Model.Count > 0)
        {
            <div class="table-responsive">
                <table class="table align-middle table-hover data-table">
                    <thead>
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Kategori Adı</th>
                            <th scope="col">Açıklama</th>
                            <th scope="col">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge badge-soft-neutral px-3 py-2 rounded-pill">
                                        @item.ID
                                    </span>
                                </td>

                                <td class="fw-semibold">@item.CategoryName</td>

                                <td class="text-muted">
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        @item.Description
                                    }
                                    else
                                    {
                                        <span>Açıklama yok</span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <a asp-area="Admin" asp-controller="Category" asp-action="Update" asp-route-id="@item.ID"
                                           class="btn btn-sm btn-outline-primary px-3">
                                            <i class="fa-solid fa-pen-to-square me-1" aria-hidden="true"></i> Düzenle
                                        </a>

                                        <button type="button"
                                                onclick="confirmCategoryDelete(@item.ID)"
                                                class="btn btn-sm btn-outline-danger px-3">
                                            <i class="fa-solid fa-trash me-1" aria-hidden="true"></i> Sil
                                        </button>

                                        <form asp-area="Admin" asp-controller="Category" asp-action="Delete" asp-route-id="@item.ID"
                                              method="post" id="deleteCategoryForm_@item.ID" class="d-none"></form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
                </div>
                <h4>Henüz kategori eklenmemiş</h4>
                <p>Sistemde görüntülenecek kategori bulunamadı.</p>
                <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="btn btn-brand">
                    <i class="fa-solid fa-plus me-2" aria-hidden="true"></i> İlk Kategoriyi Ekle
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function confirmCategoryDelete(id) {
            Swal.fire({
                title: 'Emin misin?',
                text: "Bu kategoriyi silmek istediğine emin misin?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Evet, sil',
                cancelButtonText: 'Vazgeç',
                confirmButtonColor: '#d92d20',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteCategoryForm_' + id).submit();
                }
            });
        }
    </script>
}
