@model CoreShop.Areas.Models.AdminDashboardVM
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="row g-3 mb-4">

        <div class="col-xl col-md-4 col-6">
            <div class="stat-card">
                <div class="stat-icon" style="background: var(--info-bg); color: var(--info);">
                    <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                </div>
                <span class="stat-label">Toplam Ürün</span>
                <h2>@Model.ProductCount</h2>
            </div>
        </div>

        <div class="col-xl col-md-4 col-6">
            <div class="stat-card">
                <div class="stat-icon" style="background: var(--warning-bg); color: var(--warning);">
                    <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
                </div>
                <span class="stat-label">Toplam Kategori</span>
                <h2>@Model.CategoryCount</h2>
            </div>
        </div>

        <div class="col-xl col-md-4 col-6">
            <div class="stat-card">
                <div class="stat-icon" style="background: var(--brand-50); color: var(--brand-600);">
                    <i class="fa-solid fa-receipt" aria-hidden="true"></i>
                </div>
                <span class="stat-label">Toplam Sipariş</span>
                <h2>@Model.OrderCount</h2>
            </div>
        </div>

        <div class="col-xl col-md-4 col-6">
            <div class="stat-card">
                <div class="stat-icon" style="background: var(--info-bg); color: var(--info);">
                    <i class="fa-solid fa-users" aria-hidden="true"></i>
                </div>
                <span class="stat-label">Toplam Kullanıcı</span>
                <h2>@Model.UserCount</h2>
            </div>
        </div>

        <div class="col-xl col-md-4 col-6">
            <div class="stat-card">
                <div class="stat-icon" style="background: var(--success-bg); color: var(--success);">
                    <i class="fa-solid fa-turkish-lira-sign" aria-hidden="true"></i>
                </div>
                <span class="stat-label">Toplam Gelir</span>
                <h2>@Model.TotalRevenue.ToTryPrice()</h2>
            </div>
        </div>

    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="surface p-4 mb-4">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="h5 fw-bold mb-0">Hızlı İşlemler</h2>
                    <small class="text-muted">Kısayollar</small>
                </div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="action-card tint-info">
                            <i class="fa-solid fa-plus" aria-hidden="true"></i>
                            <div>
                                <strong>Ürün Ekle</strong>
                                <small>Yeni ürün oluştur</small>
                            </div>
                        </a>
                    </div>

                    <div class="col-md-6">
                        <a asp-area="Admin" asp-controller="Product" asp-action="List" class="action-card tint-success">
                            <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                            <div>
                                <strong>Ürünleri Yönet</strong>
                                <small>Listele, güncelle, sil</small>
                            </div>
                        </a>
                    </div>

                    <div class="col-md-6">
                        <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="action-card tint-brand">
                            <i class="fa-solid fa-folder-plus" aria-hidden="true"></i>
                            <div>
                                <strong>Kategori Ekle</strong>
                                <small>Yeni kategori oluştur</small>
                            </div>
                        </a>
                    </div>

                    <div class="col-md-6">
                        <a asp-area="Admin" asp-controller="Order" asp-action="List" class="action-card tint-danger">
                            <i class="fa-solid fa-receipt" aria-hidden="true"></i>
                            <div>
                                <strong>Siparişler</strong>
                                <small>Durumları yönet</small>
                            </div>
                        </a>
                    </div>

                </div>

            </div>

            <div class="surface p-4">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 fw-bold mb-0">
                        <i class="fa-solid fa-triangle-exclamation text-warning me-2" aria-hidden="true"></i>
                        Kritik Stok Durumu
                    </h2>
                    <small class="text-muted">5 ve altı stoklar</small>
                </div>

                @if (Model.LowStockProducts.Any())
                {
                    @foreach (var item in Model.LowStockProducts)
                    {
                        <div class="product-row">

                            <div>
                                <div class="fw-semibold">@item.ProductName</div>
                                <small class="text-muted">@item.ProductPrice.ToTryPrice()</small>
                            </div>

                            @if (item.ProductStock == 0)
                            {
                                <span class="badge badge-soft-danger rounded-pill px-3 py-2">
                                    Tükendi
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-soft-warning rounded-pill px-3 py-2">
                                    @item.ProductStock adet
                                </span>
                            }

                        </div>
                    }

                    @if (Model.LowStockCount > 6)
                    {
                        <div class="text-center mt-3">

                            <small class="text-muted d-block mb-2">
                                +@(Model.LowStockCount - 6) ürün daha kritik stokta
                            </small>

                            <a asp-area="Admin" asp-controller="Product" asp-action="List" asp-route-sort="low_stock"
                               class="btn btn-sm btn-soft rounded-pill px-4">
                                Tümünü Gör
                            </a>

                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">Kritik stokta ürün yok. 👌</p>
                }

            </div>

        </div>

        <div class="col-lg-4">

            <div class="surface p-4">

                <h2 class="h5 fw-bold mb-3">Son Eklenen Ürünler</h2>

                @foreach (var item in Model.LastProducts)
                {
                    <div class="product-row">

                        <div>
                            <div class="fw-semibold">@item.ProductName</div>
                            <small class="text-muted">@item.ProductPrice.ToTryPrice()</small>
                        </div>

                        <span class="badge badge-soft-info rounded-pill px-3 py-2">
                            @item.ProductStock adet
                        </span>

                    </div>
                }

            </div>

        </div>

    </div>
</div>
