@model CoreShop.Models.ErrorPageVM

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5 text-center">
    <div class="surface p-5 mx-auto" style="max-width:520px;">

        <div class="error-icon mx-auto mb-4">
            <i class="@Model.IconCssClass" aria-hidden="true"></i>
        </div>

        <p class="text-muted fw-semibold mb-1">Hata @Model.StatusCode</p>
        <h2 class="fw-bold mb-3">@Model.Title</h2>

        <p class="text-muted mb-4">@Model.Message</p>

        <a asp-controller="Home" asp-action="Index" class="btn btn-brand w-100 mb-2">
            <i class="fa-solid fa-house me-2" aria-hidden="true"></i> Ana Sayfaya Dön
        </a>

        <a asp-controller="Product" asp-action="Index" class="btn btn-soft w-100">
            <i class="fa-solid fa-store me-2" aria-hidden="true"></i> Ürünlere Göz At
        </a>

    </div>
</div>
