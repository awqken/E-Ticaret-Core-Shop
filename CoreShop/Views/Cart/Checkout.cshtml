@model CoreShop.Models.CheckoutVM

@{
    ViewData["Title"] = "Ödeme";
}

<div class="section-head">
    <h1 class="h3 mb-1">Ödeme</h1>
    <p>Teslimat ve kart bilgilerini doldurarak siparişini tamamla.</p>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger shadow-sm" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2" aria-hidden="true"></i> @ViewBag.Error
    </div>
}

<div class="row g-4">

    <div class="col-lg-7">
        <div class="surface p-4 p-lg-5">

            <form asp-action="Checkout" method="post" novalidate>

                <h2 class="h5 fw-bold mb-4">
                    <i class="fa-solid fa-truck-fast me-2 text-muted" aria-hidden="true"></i> Teslimat Bilgileri
                </h2>

                <div class="form-floating mb-3">
                    <input asp-for="FullName"
                           class="form-control"
                           placeholder="Ad Soyad"
                           autocomplete="name" />
                    <label asp-for="FullName">Ad Soyad</label>
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Telefon Numarası" autocomplete="tel" inputmode="tel" />
                    <label asp-for="PhoneNumber">Telefon Numarası</label>
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="City" class="form-control" placeholder="Şehir" autocomplete="address-level1" />
                            <label asp-for="City">Şehir</label>
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="District" class="form-control" placeholder="İlçe" autocomplete="address-level2" />
                            <label asp-for="District">İlçe</label>
                            <span asp-validation-for="District" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="form-floating mb-4">
                    <textarea asp-for="FullAddress" class="form-control" style="height:110px;" placeholder="Açık Adres" autocomplete="street-address"></textarea>
                    <label asp-for="FullAddress">Açık Adres</label>
                    <span asp-validation-for="FullAddress" class="text-danger small"></span>
                </div>

                <h2 class="h5 fw-bold mb-4 mt-2">
                    <i class="fa-solid fa-credit-card me-2 text-muted" aria-hidden="true"></i> Kart Bilgileri
                </h2>

                <div class="form-floating mb-3">
                    <input asp-for="CardName"
                           class="form-control"
                           placeholder="Kart Üzerindeki İsim"
                           autocomplete="cc-name" />
                    <label asp-for="CardName">Kart Üzerindeki İsim</label>
                    <span asp-validation-for="CardName" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="CardNumber" class="form-control" maxlength="19" inputmode="numeric" autocomplete="cc-number" placeholder="Kart Numarası" />
                    <label asp-for="CardNumber">Kart Numarası</label>
                    <span asp-validation-for="CardNumber" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="ExpireDate" class="form-control" maxlength="5" inputmode="numeric" autocomplete="cc-exp" placeholder="AA/YY" />
                            <label asp-for="ExpireDate">Son Kullanma (AA/YY)</label>
                            <span asp-validation-for="ExpireDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="CVV" class="form-control" maxlength="3" inputmode="numeric" autocomplete="cc-csc" placeholder="CVV" />
                            <label asp-for="CVV">CVV</label>
                            <span asp-validation-for="CVV" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-brand btn-lg w-100 mt-3">
                    <i class="fa-solid fa-lock me-2" aria-hidden="true"></i> Siparişi Tamamla
                </button>

                <p class="text-muted small text-center mt-3 mb-0">
                    <i class="fa-solid fa-shield-halved me-1" aria-hidden="true"></i>
                    Bu bir demo mağazadır; ödeme simüle edilir, kart bilgileri saklanmaz.
                </p>

            </form>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="surface p-4 position-sticky" style="top: 96px;">

            <h2 class="h5 fw-bold mb-3">Sipariş Özeti</h2>

            @foreach (var item in Model.Items)
            {
                <div class="order-line">
                    <div class="d-flex align-items-center gap-3">
                        <div class="order-line-thumb">
                            <img src="~/images/@item.ProductImage"
                                 alt="@item.ProductName"
                                 loading="lazy"
                                 width="56" height="56"
                                 onerror="this.src='/images/products/default.svg'" />
                        </div>
                        <div>
                            <div class="fw-semibold small">@item.ProductName</div>
                            <small class="text-muted">@item.Quantity adet</small>
                        </div>
                    </div>
                    <div class="fw-bold small">
                        @((item.ProductPrice * item.Quantity).ToTryPrice())
                    </div>
                </div>
            }

            <div class="summary-row mt-3">
                <span>Ara Toplam</span>
                <span>@Model.TotalPrice.ToTryPrice()</span>
            </div>

            <div class="summary-row">
                <span>Kargo</span>
                <span class="text-success fw-semibold">Ücretsiz</span>
            </div>

            <div class="summary-total">
                <span>Toplam</span>
                <span>@Model.TotalPrice.ToTryPrice()</span>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.querySelector('[name="CardNumber"]').addEventListener("input", function () {
            const digits = this.value.replace(/\D/g, '').slice(0, 16);
            this.value = digits.replace(/(\d{4})(?=\d)/g, '$1 ');
        });

        document.querySelector('[name="CVV"]').addEventListener("input", function () {
            this.value = this.value.replace(/\D/g, '').slice(0, 3);
        });

        document.querySelector('[name="ExpireDate"]').addEventListener("input", function () {
            let val = this.value.replace(/\D/g, '').slice(0, 4);

            if (val.length >= 3) {
                this.value = val.slice(0, 2) + '/' + val.slice(2);
            } else {
                this.value = val;
            }
        });
    </script>
}
