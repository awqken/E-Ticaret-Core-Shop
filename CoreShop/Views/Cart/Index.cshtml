@model IReadOnlyList<CoreShop.Models.CartItem>

@{
    ViewData["Title"] = "Sepetim";
    var totalQuantity = Model.Sum(x => x.Quantity);
    var totalPrice = Model.Sum(x => x.ProductPrice * x.Quantity);
}

<div class="section-head">
    <h1 class="h3 mb-1">Sepetim</h1>
    <p>Sepetindeki ürünleri buradan yönetebilirsin.</p>
</div>

@if (Model.Any())
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="surface p-4">
                @foreach (var item in Model)
                {
                    <div class="cart-item">
                        <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId"
                           class="cart-thumb" aria-label="@item.ProductName detayına git">
                            <img src="~/images/@item.ProductImage"
                                 alt="@item.ProductName"
                                 loading="lazy"
                                 width="84" height="84"
                                 onerror="this.src='/images/products/default.svg'" />
                        </a>

                        <div class="flex-grow-1" style="min-width: 160px;">
                            <div class="fw-semibold">@item.ProductName</div>
                            <small class="text-muted">Birim fiyat: @item.ProductPrice.ToTryPrice()</small>
                        </div>

                        <div class="qty-stepper" aria-label="@item.ProductName adedi">
                            <form asp-controller="Cart" asp-action="Decrease" asp-route-id="@item.ProductId" method="post" class="d-inline">
                                <button type="submit" class="qty-btn" aria-label="Adedi azalt">−</button>
                            </form>

                            <span class="qty-value">@item.Quantity</span>

                            <form asp-controller="Cart" asp-action="Increase" asp-route-id="@item.ProductId" method="post" class="d-inline">
                                <button type="submit" class="qty-btn" aria-label="Adedi artır">+</button>
                            </form>
                        </div>

                        <div class="fw-bold text-end" style="min-width: 110px;">
                            @((item.ProductPrice * item.Quantity).ToTryPrice())
                        </div>

                        <form asp-controller="Cart" asp-action="RemoveFromCart" asp-route-id="@item.ProductId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-soft btn-sm text-danger" aria-label="@item.ProductName ürününü sepetten çıkar">
                                <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="surface p-4 position-sticky" style="top: 96px;">
                <h2 class="h5 fw-bold mb-3">Sipariş Özeti</h2>

                <div class="summary-row">
                    <span>Ürünler (@totalQuantity adet)</span>
                    <span>@totalPrice.ToTryPrice()</span>
                </div>

                <div class="summary-row">
                    <span>Kargo</span>
                    <span class="text-success fw-semibold">Ücretsiz</span>
                </div>

                <div class="summary-total">
                    <span>Toplam</span>
                    <span>@totalPrice.ToTryPrice()</span>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <a asp-controller="Cart" asp-action="Checkout" class="btn btn-brand btn-lg">
                        Ödemeye Geç <i class="fa-solid fa-arrow-right ms-2" aria-hidden="true"></i>
                    </a>

                    <a asp-controller="Product" asp-action="Index" class="btn btn-soft">
                        Alışverişe Devam Et
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
        </div>
        <h4>Sepetin şu an boş</h4>
        <p>Beğendiğin ürünleri sepete ekleyerek alışverişe başlayabilirsin.</p>
        <a asp-controller="Product" asp-action="Index" class="btn btn-brand">
            <i class="fa-solid fa-store me-2" aria-hidden="true"></i> Ürünlere Göz At
        </a>
    </div>
}
