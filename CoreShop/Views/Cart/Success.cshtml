@{
    ViewData["Title"] = "Sipariş Alındı";
    var orderId = ViewBag.OrderId as int?;
}

<div class="container py-5 text-center">

    <div class="surface p-5 mx-auto" style="max-width: 520px;">

        <div class="error-icon mx-auto mb-4" style="background: var(--success-bg); color: var(--success);">
            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
        </div>

        <h1 class="h3 fw-bold mb-2">Siparişin Alındı 🎉</h1>

        @if (orderId.HasValue)
        {
            <span class="badge badge-soft-success rounded-pill px-3 py-2 mb-3">
                Sipariş No: #@orderId
            </span>
        }

        <p class="text-muted mb-4">
            Siparişin başarıyla oluşturuldu. En kısa sürede hazırlanıp kargoya verilecek.
            Durumunu hesabından takip edebilirsin.
        </p>

        <div class="d-grid gap-2">
            <a asp-controller="Account" asp-action="Profile" class="btn btn-brand">
                <i class="fa-solid fa-box me-2" aria-hidden="true"></i> Siparişlerimi Gör
            </a>

            <a asp-controller="Home" asp-action="Index" class="btn btn-soft">
                Ana Sayfaya Dön
            </a>
        </div>

    </div>

</div>
