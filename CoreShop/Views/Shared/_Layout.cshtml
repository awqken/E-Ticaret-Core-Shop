<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CoreShop</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">İçeriğe atla</a>

    <div class="announce-bar">
        <i class="fa-solid fa-bolt me-1" aria-hidden="true"></i>
        Sezon fırsatları başladı — seçili donanımda <strong>%19'a varan indirim</strong>.
        <a asp-controller="Product" asp-action="Index">Fırsatları gör</a>
    </div>

    <nav class="navbar navbar-expand-lg navbar-shell py-2 sticky-top" aria-label="Ana gezinme">
        <div class="container">
            <a class="navbar-brand brand-logo" asp-controller="Home" asp-action="Index">
                <span class="brand-bolt"><i class="fa-solid fa-bolt" aria-hidden="true"></i></span>
                Core<span class="brand-core">Shop</span>
            </a>

            <button class="navbar-toggler border-0 shadow-none px-2"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Menüyü aç">
                <i class="fa-solid fa-bars fa-lg text-dark" aria-hidden="true"></i>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                <ul class="navbar-nav ms-lg-3">
                    <li class="nav-item">
                        <a class="nav-link nav-link-main" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-main" asp-controller="Product" asp-action="Index">Ürünler</a>
                    </li>
                </ul>

                <form asp-controller="Product"
                      asp-action="Index"
                      method="get"
                      role="search"
                      data-no-loading="true"
                      class="d-flex navbar-search ms-lg-4 me-lg-4 my-2 my-lg-0">
                    <div class="input-group">
                        <input type="search"
                               name="search"
                               class="form-control"
                               placeholder="İşlemci, ekran kartı, SSD ara..."
                               aria-label="Ürün ara"
                               value="@(Context.Request.Query["search"])" />

                        <button class="btn btn-dark" type="submit" aria-label="Ara">
                            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        </button>
                    </div>
                </form>

                <div class="d-flex align-items-center justify-content-lg-end navbar-actions ms-lg-auto">

                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <a asp-area="Admin"
                           asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-soft">
                            <i class="fa-solid fa-screwdriver-wrench me-2" aria-hidden="true"></i> Admin
                        </a>
                    }

                    @if (User.Identity == null || !User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn btn-outline-dark">
                            Giriş Yap
                        </a>

                        <a asp-controller="Account"
                           asp-action="Register"
                           class="btn btn-brand d-none d-sm-inline-flex">
                            Kayıt Ol
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Profile"
                           class="btn btn-soft">
                            <i class="fa-solid fa-user me-2" aria-hidden="true"></i> Hesabım
                        </a>
                    }

                    <a class="cart-btn"
                       asp-controller="Cart"
                       asp-action="Index"
                       aria-label="Sepetim">
                        <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
                        @await Component.InvokeAsync("CartBadge")
                    </a>

                </div>
            </div>
        </div>
    </nav>

    <main id="main-content" class="container py-4 page-wrapper">
        @RenderBody()
    </main>

    <footer class="footer pt-5 pb-3">
        <div class="container">
            <div class="row g-4 pb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="footer-brand mb-3">Core<span>Shop</span></div>
                    <p class="mb-4 pe-lg-5">
                        Yeni nesil PC donanımı ve oyuncu ekipmanında güvenilir adres.
                        İşlemciden kasaya, sistemini parça parça değil — akıllıca kur.
                    </p>
                    <div class="footer-social">
                        <a href="#" aria-label="X (Twitter)"><i class="fa-brands fa-x-twitter" aria-hidden="true"></i></a>
                        <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram" aria-hidden="true"></i></a>
                        <a href="#" aria-label="YouTube"><i class="fa-brands fa-youtube" aria-hidden="true"></i></a>
                        <a href="#" aria-label="Discord"><i class="fa-brands fa-discord" aria-hidden="true"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6>Mağaza</h6>
                    <ul class="list-unstyled mb-0">
                        <li><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                        <li><a asp-controller="Product" asp-action="Index">Tüm Ürünler</a></li>
                        <li><a asp-controller="Cart" asp-action="Index">Sepetim</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6 col-6">
                    <h6>Popüler Kategoriler</h6>
                    <ul class="list-unstyled mb-0">
                        <li><a asp-controller="Product" asp-action="Index" asp-route-categoryIdSingle="1">İşlemci</a></li>
                        <li><a asp-controller="Product" asp-action="Index" asp-route-categoryIdSingle="2">Ekran Kartı</a></li>
                        <li><a asp-controller="Product" asp-action="Index" asp-route-categoryIdSingle="5">SSD</a></li>
                        <li><a asp-controller="Product" asp-action="Index" asp-route-categoryIdSingle="10">Monitör</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6>Hesap</h6>
                    <ul class="list-unstyled mb-0">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li><a asp-controller="Account" asp-action="Profile">Hesabım</a></li>
                            <li><a asp-controller="Account" asp-action="Profile">Siparişlerim</a></li>
                        }
                        else
                        {
                            <li><a asp-controller="Account" asp-action="Login">Giriş Yap</a></li>
                            <li><a asp-controller="Account" asp-action="Register">Kayıt Ol</a></li>
                        }
                    </ul>
                </div>
            </div>

            <div class="footer-bottom pt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>© 2026 CoreShop — Tüm hakları saklıdır.</span>
                <span>Portfolyo amaçlı demo mağaza; ödemeler simüle edilir.</span>
            </div>
        </div>
    </footer>

    <partial name="_Toasts" />

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
