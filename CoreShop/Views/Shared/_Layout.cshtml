@using System.Security.Claims
@{
    var userName = User.Identity != null && User.Identity.IsAuthenticated ? User.Identity.Name : null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CoreShop</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            background-color: #f8f9fa;
            color: #111827;
            display: flex;
            flex-direction: column;
        }

        .topbar-custom {
            background-color: #212529;
            color: #f8f9fa;
            font-size: 13px;
        }

        .navbar-custom {
            background-color: white;
            border-bottom: 1px solid #e5e7eb;
        }

        .brand-main {
            font-size: 28px;
            font-weight: 800;
            color: #ff6000 !important;
            letter-spacing: -0.5px;
        }

            .brand-main span {
                color: #111827;
            }

        .nav-link-custom {
            color: #111827 !important;
            font-weight: 600;
            margin-right: 10px;
            transition: 0.2s ease;
        }

            .nav-link-custom:hover {
                color: #ff6000 !important;
            }

        .cart-btn {
            background-color: #ff6000;
            color: white !important;
            border-radius: 12px;
            padding: 10px 18px !important;
            font-weight: 600;
            position: relative;
            transition: 0.2s ease;
        }

            .cart-btn:hover {
                background-color: #e65300;
            }

        .footer-custom {
            background-color: #212529;
            color: #d1d5db;
            margin-top: 0;
        }

        .page-wrapper {
            flex: 1;
        }

        .form-control:focus {
            box-shadow: none;
            border-color: #ff6000;
        }

        .input-group .form-control {
            border: 1px solid #dee2e6;
            height: 46px;
        }

        .input-group .btn {
            height: 46px;
        }

        .navbar-search-form {
            max-width: 420px;
            width: 100%;
        }

        .navbar-right-actions {
            margin-left: 24px;
            gap: 14px;
        }

        @@media (max-width: 991px) {
            .navbar-search-form {
                max-width: 100%;
                margin-top: 16px;
                margin-bottom: 16px;
            }

            .navbar-right-actions {
                margin-left: 0;
                margin-top: 12px;
                justify-content: flex-start !important;
                flex-wrap: wrap;
            }

                .navbar-right-actions a {
                    white-space: nowrap;
                }

            .nav-link-custom {
                margin-right: 0;
            }
        }
    </style>
</head>
<body>  
    <div class="topbar-custom py-2">
        <div class="container d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <i class="fa-solid fa-shield-halved me-2"></i> Güvenli Alışveriş
            </div>
            <div>
                <i class="fa-solid fa-truck-fast me-2"></i> Teknoloji Ürünleri
            </div>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg navbar-custom py-3 sticky-top">
        <div class="container">
            <a class="navbar-brand brand-main" asp-controller="Home" asp-action="Index">
                Core<span>Shop</span>
            </a>

            <button class="navbar-toggler border-0 shadow-none px-2"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Menüyü aç">
                <i class="fa-solid fa-bars fa-lg" style="color:#111827;"></i>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                <ul class="navbar-nav ms-4">
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" asp-controller="Product" asp-action="Index">Ürünler</a>
                    </li>
                </ul>

                <form asp-controller="Product"
                      asp-action="Index"
                      method="get"
                      class="d-flex navbar-search-form ms-lg-4 me-lg-4">
                    <div class="input-group">
                        <input type="text"
                               name="search"
                               class="form-control rounded-start-pill px-4"
                               placeholder="Ürün ara..."
                               value="@(Context.Request.Query["search"])" />

                        <button class="btn btn-warning rounded-end-pill px-4 fw-semibold" type="submit">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </button>
                    </div>
                </form>

                <div class="d-flex align-items-center justify-content-lg-end navbar-right-actions ms-lg-auto">

                @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <a asp-area="Admin"
                       asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-secondary rounded-3 px-3">
                        <i class="fa-solid fa-screwdriver-wrench me-2"></i> Admin
                    </a>
                }

                @if (!User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-outline-dark rounded-3 px-3">
                        <i class="fa-solid fa-right-to-bracket me-2"></i> Giriş Yap
                    </a>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Profile"
                       class="btn btn-dark rounded-3 px-3">
                        <i class="fa-solid fa-user me-2"></i> Profil
                    </a>
                }

                <a class="nav-link cart-btn d-inline-flex align-items-center"
                   asp-controller="Cart"
                   asp-action="Index">
                    <i class="fa-solid fa-cart-shopping me-2"></i> Sepet

                    @if (ViewBag.CartCount != null && (int)ViewBag.CartCount > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-dark">
                            @ViewBag.CartCount
                        </span>
                    }
                </a>

            </div>
            </div>
        </div>
    </nav>

    <main class="container py-4 page-wrapper flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer-custom py-4">
        <div class="container text-center">
            <p class="mb-1 fw-semibold">© 2026 CoreShop - Tüm Hakları Saklıdır</p>
            <small>Bilgisayar parçaları ve teknoloji ürünleri mağazası</small>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>