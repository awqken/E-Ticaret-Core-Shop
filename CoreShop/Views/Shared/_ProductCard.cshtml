@using CoreShop.Helpers
@model CoreShop.MODEL.Entities.Product

@{
    var discount = Model.ProductPrice.DiscountPercentFrom(Model.OldPrice);
    var pngImage = System.IO.Path.ChangeExtension(Model.ProductImage, ".png");
}

<article class="awwwards-product-tile p-4 rounded-5 bg-subtle-gray border-0 position-relative text-center d-flex flex-column h-100 transition-all">
    <div class="pcard-media position-relative py-3 bg-transparent text-center flex-grow-1">
        <img src="~/images/@pngImage"
             alt="@Model.ProductName"
             loading="lazy"
             width="240" height="190"
             class="img-fluid pcard-img mx-auto"
             onerror="this.src='/images/products/default.svg'" />

        @if (discount > 0)
        {
            <span class="badge bg-black text-white fw-bold rounded-pill position-absolute top-0 start-0 px-2.5 py-1" style="font-size: 0.75rem;">
                -%@discount
            </span>
        }
    </div>

    <div class="pcard-body text-start pt-3">
        <div class="d-flex align-items-center justify-content-between mb-1">
            <span class="text-secondary small fw-semibold text-uppercase tracking-wider" style="font-size: 0.75rem;">@Model.ProductBrand</span>
            @if (Model.ProductStock == 0)
            {
                <span class="text-danger small fw-semibold">Tükendi</span>
            }
            else
            {
                <span class="text-muted small" style="font-size: 0.75rem;"><i class="fa-solid fa-circle text-success me-1" style="font-size: 0.45rem;"></i> Stokta Var</span>
            }
        </div>

        <h3 class="fs-6 fw-bold text-black mb-3 text-truncate">
            <a asp-controller="Product" asp-action="Detail" asp-route-id="@Model.ID" class="text-black text-decoration-none hover-underline">
                @Model.ProductName
            </a>
        </h3>

        <div class="d-flex align-items-center justify-content-between pt-2">
            <div>
                @if (discount > 0)
                {
                    <span class="text-muted text-decoration-line-through d-block small" style="font-size: 0.78rem;">@Model.OldPrice!.Value.ToTryPrice()</span>
                }
                <span class="fw-bold text-black fs-5">@Model.ProductPrice.ToTryPrice()</span>
            </div>

            @if (Model.ProductStock > 0)
            {
                <div class="d-flex gap-2">
                    <a asp-controller="Product" asp-action="Detail" asp-route-id="@Model.ID" class="btn btn-outline-dark btn-sm rounded-pill px-3 py-1.5 fw-semibold" aria-label="İncele">
                        İncele
                    </a>
                    <form asp-controller="Cart" asp-action="AddToCart" asp-route-id="@Model.ID" method="post" class="m-0">
                        <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                        <button type="submit" class="btn btn-black-pill btn-sm rounded-pill px-3 py-1.5 fw-semibold text-white" aria-label="Sepete Ekle">
                            <i class="fa-solid fa-cart-plus" aria-hidden="true"></i>
                        </button>
                    </form>
                </div>
            }
            else
            {
                <button type="button" class="btn btn-gray-pill btn-sm rounded-pill px-3.5 py-1.5 text-muted" disabled aria-label="Tükendi">
                    Tükendi
                </button>
            }
        </div>
    </div>
</article>
