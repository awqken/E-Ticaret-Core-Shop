@using CoreShop.Helpers
@model CoreShop.MODEL.Entities.Product

@{
    var discount = Model.ProductPrice.DiscountPercentFrom(Model.OldPrice);
}

<article class="pcard">
    <div class="pcard-media">
        <img src="~/images/@Model.ProductImage"
             alt="@Model.ProductName"
             loading="lazy"
             width="260" height="195"
             onerror="this.src='/images/products/default.svg'" />

        <div class="pcard-flags">
            @if (discount > 0)
            {
                <span class="flag flag-hot">-%@discount</span>
            }
            @if (Model.ProductStock == 0)
            {
                <span class="flag flag-out">Tükendi</span>
            }
            else if (Model.ProductStock <= 5)
            {
                <span class="flag flag-low">Son @Model.ProductStock adet</span>
            }
        </div>

        <div class="pcard-quick">
            <button type="button"
                    class="quick-btn wish-btn"
                    data-product-id="@Model.ID"
                    aria-pressed="false"
                    aria-label="@Model.ProductName ürününü favorilere ekle">
                <i class="fa-solid fa-heart" aria-hidden="true"></i>
            </button>

            <a asp-controller="Product" asp-action="Detail" asp-route-id="@Model.ID"
               class="quick-btn"
               aria-label="@Model.ProductName detayına git">
                <i class="fa-solid fa-eye" aria-hidden="true"></i>
            </a>
        </div>
    </div>

    <div class="pcard-body">
        <div class="pcard-brand">@Model.ProductBrand</div>

        <h3 class="pcard-name">
            <a asp-controller="Product" asp-action="Detail" asp-route-id="@Model.ID">
                @Model.ProductName
            </a>
        </h3>

        @if (Model.ProductStock == 0)
        {
            <span class="pcard-stock stock-out">Stokta yok</span>
        }
        else if (Model.ProductStock <= 5)
        {
            <span class="pcard-stock stock-low">Sınırlı stok</span>
        }
        else
        {
            <span class="pcard-stock stock-in">Stokta var</span>
        }

        <div class="pcard-foot">
            <div>
                @if (discount > 0)
                {
                    <span class="price-old">@Model.OldPrice!.Value.ToTryPrice()</span>
                }
                <span class="price-now">@Model.ProductPrice.ToTryPrice()</span>
            </div>

            @if (Model.ProductStock > 0)
            {
                <form asp-controller="Cart" asp-action="AddToCart" asp-route-id="@Model.ID" method="post" class="pcard-cart">
                    <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                    <button type="submit" class="btn btn-brand btn-icon"
                            aria-label="@Model.ProductName ürününü sepete ekle">
                        <i class="fa-solid fa-cart-plus" aria-hidden="true"></i>
                    </button>
                </form>
            }
            else
            {
                <button type="button" class="btn btn-soft btn-icon pcard-cart" disabled
                        aria-label="Stokta yok">
                    <i class="fa-solid fa-ban" aria-hidden="true"></i>
                </button>
            }
        </div>
    </div>
</article>
