@using CoreShop.MODEL.Enums
@model OrderStatus

@{
    var badgeCssClass = Model switch
    {
        OrderStatus.Pending => "badge-soft-neutral",
        OrderStatus.Paid => "badge-soft-success",
        OrderStatus.Preparing => "badge-soft-warning",
        OrderStatus.Shipped => "badge-soft-info",
        OrderStatus.Delivered => "badge-soft-success",
        OrderStatus.Cancelled => "badge-soft-danger",
        _ => "badge-soft-neutral"
    };

    var icon = Model switch
    {
        OrderStatus.Pending => "fa-solid fa-hourglass-half",
        OrderStatus.Paid => "fa-solid fa-credit-card",
        OrderStatus.Preparing => "fa-solid fa-box-open",
        OrderStatus.Shipped => "fa-solid fa-truck-fast",
        OrderStatus.Delivered => "fa-solid fa-circle-check",
        OrderStatus.Cancelled => "fa-solid fa-circle-xmark",
        _ => "fa-solid fa-circle-info"
    };
}

<span class="badge rounded-pill @badgeCssClass px-3 py-2">
    <i class="@icon me-1" aria-hidden="true"></i> @Model.ToDisplayName()
</span>
