@model CoreShop.Models.LoginVM

@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="container auth-wrapper">
    <div class="row justify-content-center w-100">
        <div class="col-lg-10 col-xl-9">
            <div class="card auth-card">
                <div class="row g-0">

                    <div class="col-lg-5 d-none d-lg-block">
                        <div class="auth-side auth-side-dark">
                            <div class="auth-side-icon">
                                <i class="fa-solid fa-user-lock" aria-hidden="true"></i>
                            </div>

                            <h2 class="text-white">CoreShop’a Hoş Geldin</h2>
                            <p>
                                Bilgisayar parçaları ve teknoloji ürünlerini daha hızlı incelemek,
                                sepetini yönetmek ve alışverişine devam etmek için hesabına giriş yap.
                            </p>
                        </div>
                    </div>

                    <div class="col-lg-7">
                        <div class="auth-body">
                            <h1 class="auth-title">Giriş Yap</h1>
                            <p class="auth-subtitle">Hesabına giriş yaparak devam et.</p>

                            <div asp-validation-summary="ModelOnly" class="text-danger fw-semibold mb-3"></div>

                            <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label">E-Posta</label>
                                    <input asp-for="Email" class="form-control auth-input" placeholder="ornek@mail.com" autocomplete="email" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Password" class="form-label">Şifre</label>
                                    <input asp-for="Password" class="form-control auth-input" placeholder="••••••••" autocomplete="current-password" />
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>

                                <div class="d-grid mb-3">
                                    <button type="submit" class="btn btn-brand auth-btn">
                                        <i class="fa-solid fa-right-to-bracket me-2" aria-hidden="true"></i> Giriş Yap
                                    </button>
                                </div>
                            </form>

                            <div class="text-center">
                                <span class="text-muted">Hesabın yok mu?</span>
                                <a asp-controller="Account" asp-action="Register" class="auth-link ms-1">
                                    Kayıt Ol
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
