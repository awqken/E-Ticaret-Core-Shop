@model CoreShop.Models.ProfileVM

@{
    ViewData["Title"] = "Hesabım";
    // After a failed address submit (or a successful save) land the user on the address tab.
    var activeSection = Model.ShowAddressForm || TempData.Peek("Success") != null ? "address" : "profile";
    var avatarInitial = string.IsNullOrEmpty(Model.User.FullName) ? "?" : Model.User.FullName[..1].ToUpper();
}

<div class="container-fluid py-4">

    <div class="profile-grid">

        <aside class="profile-sidebar" aria-label="Hesap menüsü">

            <div class="mb-4">
                <div class="profile-avatar" aria-hidden="true">@avatarInitial</div>

                <strong class="d-block">@Model.User.FullName</strong>
                <small class="text-muted">@Model.User.Email</small>
            </div>

            <nav class="profile-menu">
                <a href="#" onclick="showSection(event,'profile')" class="@(activeSection == "profile" ? "active" : null)">
                    <i class="fa-solid fa-user me-2" aria-hidden="true"></i> Profil
                </a>
                <a href="#" onclick="showSection(event,'address')" class="@(activeSection == "address" ? "active" : null)">
                    <i class="fa-solid fa-location-dot me-2" aria-hidden="true"></i> Adres
                </a>
                <a href="#" onclick="showSection(event,'orders')">
                    <i class="fa-solid fa-box me-2" aria-hidden="true"></i> Siparişler
                </a>
                <form asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="logout-btn">
                        <i class="fa-solid fa-right-from-bracket me-2" aria-hidden="true"></i> Çıkış
                    </button>
                </form>
            </nav>

        </aside>

        <div class="profile-content">

            <h1 class="h4 fw-bold mb-4">Hesabım</h1>

            <div id="profileSection" class="profile-section @(activeSection == "profile" ? "active" : null)">

                <div class="info-tile">
                    <div class="label">Ad Soyad</div>
                    <div class="value">@Model.User.FullName</div>
                </div>

                <div class="info-tile">
                    <div class="label">E-posta</div>
                    <div class="value">@Model.User.Email</div>
                </div>

                <div class="info-tile">
                    <div class="label">Üyelik Tipi</div>
                    <div class="value">@(Model.User.Role == "Admin" ? "Yönetici" : "Müşteri")</div>
                </div>

            </div>

            <div id="addressSection" class="profile-section @(activeSection == "address" ? "active" : null)">

                <div class="info-tile mb-3">

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong>Adres Bilgim</strong>

                        <button onclick="toggleEdit()" class="btn btn-sm btn-dark">
                            <i class="fa-solid fa-pen me-1" aria-hidden="true"></i> Düzenle
                        </button>
                    </div>

                    @if (string.IsNullOrEmpty(Model.User.City))
                    {
                        <div class="text-muted">
                            Henüz adres eklenmemiş.
                        </div>
                    }
                    else
                    {
                        <div class="mb-1"><b>Şehir:</b> @Model.User.City</div>
                        <div class="mb-1"><b>İlçe:</b> @Model.User.District</div>
                        <div class="mb-1"><b>Adres:</b> @Model.User.FullAddress</div>
                        <div><b>Telefon:</b> @Model.User.PhoneNumber</div>
                    }

                </div>

                <div id="editForm" class="info-tile" style="display:@(Model.ShowAddressForm ? "block" : "none");">

                    <form asp-action="UpdateProfile" method="post" novalidate>

                        <div asp-validation-summary="ModelOnly" class="text-danger fw-semibold mb-3"></div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="AddressForm.City" class="form-control" placeholder="Şehir" />
                                    <label asp-for="AddressForm.City">Şehir</label>
                                </div>
                                <span asp-validation-for="AddressForm.City" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="AddressForm.District" class="form-control" placeholder="İlçe" />
                                    <label asp-for="AddressForm.District">İlçe</label>
                                </div>
                                <span asp-validation-for="AddressForm.District" class="text-danger small"></span>
                            </div>

                        </div>

                        <div class="form-floating mb-1">
                            <textarea asp-for="AddressForm.FullAddress" class="form-control" placeholder="Adres" style="height:100px;"></textarea>
                            <label asp-for="AddressForm.FullAddress">Açık Adres</label>
                        </div>
                        <span asp-validation-for="AddressForm.FullAddress" class="text-danger small d-block mb-3"></span>

                        <div class="form-floating mb-1">
                            <input asp-for="AddressForm.PhoneNumber" class="form-control" placeholder="Telefon" />
                            <label asp-for="AddressForm.PhoneNumber">Telefon</label>
                        </div>
                        <span asp-validation-for="AddressForm.PhoneNumber" class="text-danger small d-block mb-3"></span>

                        <button class="btn btn-brand w-100">
                            <i class="fa-solid fa-floppy-disk me-2" aria-hidden="true"></i> Kaydet
                        </button>

                    </form>

                </div>

            </div>

            <div id="ordersSection" class="profile-section">
                @if (Model.Orders.Any())
                {
                    foreach (var entry in Model.Orders)
                    {
                        var order = entry.Order;
                        <div class="order-card mb-4">

                            <div class="order-top">

                                <div>
                                    <h2 class="h5 fw-bold mb-1">Sipariş #@order.ID</h2>
                                    <span class="order-date">
                                        @order.OrderDate.ToString("dd.MM.yyyy HH:mm")
                                    </span>
                                </div>

                                <div class="text-end">
                                    <div class="order-price">
                                        @order.TotalPrice.ToTryPrice()
                                    </div>

                                    <div class="mt-2">
                                        <partial name="_OrderStatusBadge" model="order.Status" />
                                    </div>
                                </div>

                            </div>

                            <div class="mt-3">
                                <button class="btn btn-soft btn-sm"
                                        onclick="toggleOrderDetail(@order.ID)"
                                        aria-expanded="false"
                                        aria-controls="detail_@order.ID">
                                    Detayları Göster
                                </button>
                            </div>

                            <div id="detail_@order.ID" class="order-detail-box">

                                <hr />

                                <h3 class="h6 fw-bold mb-3">Sipariş Ürünleri</h3>

                                @foreach (var item in entry.Details)
                                {
                                    <div class="order-line">

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="order-line-thumb">
                                                <img src="~/images/@item.ProductImage"
                                                     alt="@item.ProductName"
                                                     loading="lazy"
                                                     width="56" height="56"
                                                     onerror="this.src='/images/products/default.svg'" />
                                            </div>

                                            <div>
                                                <div class="fw-bold">@item.ProductName</div>
                                                <small class="text-muted">
                                                    Adet: @item.Quantity
                                                </small>
                                            </div>

                                        </div>

                                        <div class="fw-bold">
                                            @item.UnitPrice.ToTryPrice()
                                        </div>

                                    </div>
                                }

                                <hr />

                                <div class="row g-3">

                                    <div class="col-md-6">
                                        <div class="info-card">
                                            <h6><i class="fa-solid fa-location-dot me-1" aria-hidden="true"></i> Teslimat Bilgisi</h6>

                                            <small>@order.FullName</small><br />
                                            <small>@order.PhoneNumber</small><br />
                                            <small>@order.City / @order.District</small><br />
                                            <small>@order.FullAddress</small>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="info-card">
                                            <h6><i class="fa-solid fa-credit-card me-1" aria-hidden="true"></i> Ödeme Bilgisi</h6>

                                            <small>@order.CardName</small><br />
                                            <small>**** **** **** @order.CardLast4</small>
                                        </div>
                                    </div>

                                </div>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                        </div>
                        <h4>Henüz siparişin yok</h4>
                        <p>Alışverişe başladığında siparişlerin burada listelenir.</p>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-brand">
                            Ürünlere Göz At
                        </a>
                    </div>
                }
            </div>

        </div>

    </div>

</div>

<script>
    function showSection(e, section) {
        e.preventDefault();

        document.querySelectorAll(".profile-section").forEach(x => x.classList.remove("active"));
        document.getElementById(section + "Section").classList.add("active");

        document.querySelectorAll(".profile-menu a").forEach(x => x.classList.remove("active"));
        e.currentTarget.classList.add("active");
    }

    function toggleEdit() {
        const form = document.getElementById("editForm");
        form.style.display = form.style.display === "none" ? "block" : "none";
    }

    function toggleOrderDetail(id) {
        const box = document.getElementById("detail_" + id);
        const isOpen = box.style.display === "block";
        box.style.display = isOpen ? "none" : "block";

        const button = box.parentElement.querySelector('[aria-controls="detail_' + id + '"]');
        if (button) {
            button.setAttribute("aria-expanded", String(!isOpen));
            button.textContent = isOpen ? "Detayları Göster" : "Detayları Gizle";
        }
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
