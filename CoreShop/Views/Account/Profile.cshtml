@model CoreShop.Models.ProfileVM

@{
    ViewData["Title"] = "Hesabım";
    // After a failed address submit (or a successful save) land the user on the address tab.
    var activeSection = Model.ShowAddressForm || TempData.Peek("Success") != null ? "address" : "profile";
}

<style>
    body {
        background: #f8fafc;
    }

    .wrapper {
        max-width: 1200px;
        margin: auto;
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 30px;
    }

    .sidebar {
        background: white;
        border-radius: 20px;
        padding: 20px;
        border: 1px solid #e5e7eb;
    }

    .avatar {
        width: 55px;
        height: 55px;
        border-radius: 50%;
        background: #111827;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 10px;
    }

    .user {
        margin-bottom: 20px;
    }

        .user strong {
            display: block;
        }

        .user small {
            color: #6b7280;
        }

    .menu a {
        display: block;
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 8px;
        text-decoration: none;
        color: #374151;
        font-weight: 600;
        transition: 0.2s;
    }

        .menu a:hover {
            background: #f1f5f9;
        }

        .menu a.active {
            background: #111827;
            color: white;
        }

    .menu .logout-btn {
        display: block;
        width: 100%;
        text-align: left;
        padding: 12px;
        border: none;
        border-radius: 10px;
        background: none;
        color: #dc2626;
        font-weight: 600;
        font-family: inherit;
        font-size: inherit;
        cursor: pointer;
        transition: 0.2s;
    }

        .menu .logout-btn:hover {
            background: #fef2f2;
        }

    .content {
        background: white;
        border-radius: 20px;
        padding: 30px;
        border: 1px solid #e5e7eb;
    }

    .title {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .section {
        display: none;
    }

        .section.active {
            display: block;
        }

    .box {
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 15px;
        transition: 0.2s;
    }

        .box:hover {
            border-color: #d1d5db;
        }

    .label {
        font-size: 12px;
        color: #6b7280;
    }

    .value {
        font-weight: 600;
    }

    .form-control {
        border-radius: 10px;
    }

    .btn-save {
        width: 100%;
        height: 42px;
        border: none;
        border-radius: 10px;
        background: #111827;
        color: white;
        margin-top: 10px;
    }

    .empty {
        text-align: center;
        padding: 40px;
        color: #6b7280;
    }

    .order-card {
        background: #fff;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 10px 25px rgba(0,0,0,.06);
        transition: .25s;
    }

        .order-card:hover {
            transform: translateY(-3px);
        }

    .order-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    .order-date {
        color: #777;
        font-size: 14px;
    }

    .order-price {
        font-size: 24px;
        font-weight: 700;
    }

    .status-paid {
        background: #e8fff0;
        color: #1d9c57;
        padding: 6px 14px;
        border-radius: 50px;
        font-size: 13px;
        font-weight: 600;
    }

    .detail-btn {
        background: #111;
        color: #fff;
        border: none;
        padding: 10px 18px;
        border-radius: 12px;
        font-weight: 600;
        transition: .2s;
    }

        .detail-btn:hover {
            background: #333;
        }

    .detail-box {
        display: none;
        margin-top: 20px;
    }

    .section-title {
        font-size: 18px;
        margin-bottom: 15px;
    }

    .product-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #eee;
    }

    .product-img {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #eee;
    }

    .info-card {
        background: #f8f9fa;
        border-radius: 14px;
        padding: 18px;
        height: 100%;
    }
</style>

<div class="container-fluid py-5">

    <div class="wrapper">

        <div class="sidebar">

            <div class="user">
                <div class="avatar">
                    <i class="fa-solid fa-user"></i>
                </div>

                <strong>@Model.User.FullName</strong>
                <small>@Model.User.Email</small>
            </div>

            <div class="menu">
                <a href="#" onclick="showSection(event,'profile')" class="@(activeSection == "profile" ? "active" : null)">Profil</a>
                <a href="#" onclick="showSection(event,'address')" class="@(activeSection == "address" ? "active" : null)">Adres</a>
                <a href="#" onclick="showSection(event,'orders')">Siparişler</a>
                <form asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="logout-btn">Çıkış</button>
                </form>
            </div>

        </div>

        <div class="content">

            <div class="title">Hesabım</div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success rounded-4" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
                </div>
            }

            <div id="profileSection" class="section @(activeSection == "profile" ? "active" : null)">

                <div class="box">
                    <div class="label">Ad Soyad</div>
                    <div class="value">@Model.User.FullName</div>
                </div>

                <div class="box">
                    <div class="label">Email</div>
                    <div class="value">@Model.User.Email</div>
                </div>

                <div class="box">
                    <div class="label">Rol</div>
                    <div class="value">@Model.User.Role</div>
                </div>

            </div>

            <div id="addressSection" class="section @(activeSection == "address" ? "active" : null)">

                <div class="box mb-3">

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong>Adres Bilgim</strong>

                        <button onclick="toggleEdit()" class="btn btn-sm btn-dark">
                            Düzenle
                        </button>
                    </div>

                    @if (string.IsNullOrEmpty(Model.User.City))
                    {
                        <div class="text-muted">
                            Henüz adres eklenmemiş
                        </div>
                    }
                    else
                    {
                        <div class="mb-1"><b>Şehir:</b> @Model.User.City</div>
                        <div class="mb-1"><b>İlçe:</b> @Model.User.District</div>
                        <div class="mb-1"><b>Adres:</b> @Model.User.FullAddress</div>
                        <div><b>Telefon:</b> @Model.User.PhoneNumber</div>
                    }

                </div>

                <div id="editForm" class="box" style="display:@(Model.ShowAddressForm ? "block" : "none");">

                    <form asp-action="UpdateProfile" method="post" novalidate>

                        <div asp-validation-summary="ModelOnly" class="text-danger fw-semibold mb-3"></div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="AddressForm.City" class="form-control" placeholder="Şehir" />
                                    <label asp-for="AddressForm.City">Şehir</label>
                                </div>
                                <span asp-validation-for="AddressForm.City" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="AddressForm.District" class="form-control" placeholder="İlçe" />
                                    <label asp-for="AddressForm.District">İlçe</label>
                                </div>
                                <span asp-validation-for="AddressForm.District" class="text-danger small"></span>
                            </div>

                        </div>

                        <div class="form-floating mb-1">
                            <textarea asp-for="AddressForm.FullAddress" class="form-control" placeholder="Adres" style="height:100px;"></textarea>
                            <label asp-for="AddressForm.FullAddress">Açık Adres</label>
                        </div>
                        <span asp-validation-for="AddressForm.FullAddress" class="text-danger small d-block mb-3"></span>

                        <div class="form-floating mb-1">
                            <input asp-for="AddressForm.PhoneNumber" class="form-control" placeholder="Telefon" />
                            <label asp-for="AddressForm.PhoneNumber">Telefon</label>
                        </div>
                        <span asp-validation-for="AddressForm.PhoneNumber" class="text-danger small d-block mb-3"></span>

                        <button class="btn-save">
                            <i class="fa-solid fa-floppy-disk me-2"></i>
                            Kaydet
                        </button>

                    </form>

                </div>

            </div>

            <div id="ordersSection" class="section">
                @if (Model.Orders.Any())
                {
                    foreach (var entry in Model.Orders)
                    {
                        var order = entry.Order;
                        <div class="order-card mb-4">

                            <div class="order-top">

                                <div>
                                    <h4>Sipariş #@order.ID</h4>
                                    <span class="order-date">
                                        @order.OrderDate.ToString("dd.MM.yyyy HH:mm")
                                    </span>
                                </div>

                                <div class="text-end">
                                    <div class="order-price">
                                        ₺@order.TotalPrice.ToString("N2")
                                    </div>

                                    <div class="mt-2">
                                        <partial name="_OrderStatusBadge" model="order.Status" />
                                    </div>
                                </div>

                            </div>

                            <div class="mt-3">
                                <button class="detail-btn"
                                        onclick="toggleOrderDetail(@order.ID)">
                                    Detayları Göster
                                </button>
                            </div>

                            <div id="detail_@order.ID" class="detail-box">

                                <hr />

                                <h5 class="section-title">Sipariş Ürünleri</h5>

                                @foreach (var item in entry.Details)
                                {
                                    <div class="product-row">

                                        <div class="d-flex align-items-center gap-3">

                                            <img src="/images/@item.ProductImage"
                                                 class="product-img" />

                                            <div>
                                                <div class="fw-bold">@item.ProductName</div>
                                                <small class="text-muted">
                                                    Adet: @item.Quantity
                                                </small>
                                            </div>

                                        </div>

                                        <div class="fw-bold">
                                            ₺@item.UnitPrice.ToString("N2")
                                        </div>

                                    </div>
                                }

                                <hr />

                                <div class="row g-3">

                                    <div class="col-md-6">
                                        <div class="info-card">
                                            <h6>📍 Teslimat Bilgisi</h6>

                                            <small>@order.FullName</small><br />
                                            <small>@order.PhoneNumber</small><br />
                                            <small>@order.City / @order.District</small><br />
                                            <small>@order.FullAddress</small>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="info-card">
                                            <h6>💳 Ödeme Bilgisi</h6>

                                            <small>@order.CardName</small><br />
                                            <small>**** **** **** @order.CardLast4</small>
                                        </div>
                                    </div>

                                </div>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="empty">
                        <i class="fa-solid fa-box-open fa-2x mb-3 d-block"></i>
                        <div class="fw-bold mb-1">Henüz siparişin yok</div>
                        <div>Alışverişe başladığında siparişlerin burada listelenir.</div>
                    </div>
                }
            </div>

        </div>

    </div>

</div>

<script>
    function showSection(e, section){

        document.querySelectorAll(".section").forEach(x=>{
            x.classList.remove("active");
        });

        document.getElementById(section+"Section").classList.add("active");

        document.querySelectorAll(".menu a").forEach(x=>{
            x.classList.remove("active");
        });

        e.currentTarget.classList.add("active");
    }

    function toggleEdit() {
        let form = document.getElementById("editForm");

        if (form.style.display === "none") {
            form.style.display = "block";
        } else {
            form.style.display = "none";
        }
    }
        function toggleOrderDetail(id)
    {
        let box = document.getElementById("detail_" + id);

        if(box.style.display === "none" || box.style.display === "")
            box.style.display = "block";
        else
            box.style.display = "none";
    }

</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}