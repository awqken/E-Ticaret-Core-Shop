@model CoreShop.Models.RegisterVM

@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="container auth-wrapper">
    <div class="row justify-content-center w-100">
        <div class="col-lg-10 col-xl-9">
            <div class="card auth-card">
                <div class="row g-0">

                    <div class="col-lg-5 d-none d-lg-block">
                        <div class="auth-side auth-side-brand">
                            <div class="auth-side-icon">
                                <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                            </div>

                            <h2 class="text-white">CoreShop Üyesi Ol</h2>
                            <p>
                                Teknoloji ürünlerini takip etmek, sepetini yönetmek ve alışverişini
                                daha kolay tamamlamak için ücretsiz hesap oluştur.
                            </p>
                        </div>
                    </div>

                    <div class="col-lg-7">
                        <div class="auth-body">
                            <h1 class="auth-title">Kayıt Ol</h1>
                            <p class="auth-subtitle">Yeni bir hesap oluşturarak başla.</p>

                            <div asp-validation-summary="ModelOnly" class="text-danger fw-semibold mb-3"></div>

                            <form asp-controller="Account" asp-action="Register" method="post" novalidate>
                                <div class="mb-3">
                                    <label asp-for="FullName" class="form-label">Ad Soyad</label>
                                    <input asp-for="FullName" class="form-control auth-input" placeholder="Ad Soyad" autocomplete="name" />
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label">E-Posta</label>
                                    <input asp-for="Email" class="form-control auth-input" placeholder="ornek@mail.com" autocomplete="email" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Password" class="form-label">Şifre</label>
                                    <input asp-for="Password" class="form-control auth-input" placeholder="••••••••" autocomplete="new-password" />
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>

                                <div class="d-grid mb-3">
                                    <button type="submit" class="btn btn-brand auth-btn">
                                        <i class="fa-solid fa-user-plus me-2" aria-hidden="true"></i> Kayıt Ol
                                    </button>
                                </div>
                            </form>

                            <div class="text-center">
                                <span class="text-muted">Zaten hesabın var mı?</span>
                                <a asp-controller="Account" asp-action="Login" class="auth-link ms-1">
                                    Giriş Yap
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
