@model CoreShop.Models.ProductPageVM

@{
    ViewData["Title"] = "Ürünler";
    var selectedCategoryIds = Model.SelectedCategoryIds;
    var selectedBrands = Model.SelectedBrands;
}

<style>
    .filter-card {
        border: none;
        border-radius: 22px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.05);
        position: sticky;
        top: 80px;
        max-height: calc(100vh - 100px);
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: #dee2e6 transparent;
    }

    .filter-card::-webkit-scrollbar {
        width: 4px;
    }

    .filter-card::-webkit-scrollbar-thumb {
        background: #dee2e6;
        border-radius: 4px;
    }

    .filter-toggle-btn {
        display: none;
    }

    @@media (max-width: 991px) {
        .filter-card {
            position: static;
            max-height: none;
            overflow-y: visible;
        }

        .filter-toggle-btn {
            display: flex;
        }
    }

    @@media (min-width: 992px) {
        #filterCollapse {
            display: block !important;
        }
    }

    .product-card-custom {
        border: none;
        border-radius: 18px;
        transition: all 0.25s ease;
        box-shadow: 0 4px 16px rgba(0,0,0,0.05);
        height: 100%;
        min-height: 100%;
        background: #fff;
    }

        .product-card-custom:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 24px rgba(0,0,0,0.08);
        }

    .product-image-wrapper {
        height: 180px;
        width: 100%;
        background: linear-gradient(145deg, #f8f9fa, #f1f3f5);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px;
        overflow: hidden;
        border: 1px solid #ececec;
        margin-bottom: 12px;
        flex-shrink: 0;
    }

    .product-img-custom {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
    }

    .product-card-body {
        display: flex;
        flex-direction: column;
        height: 100%;
        text-align: center;
        align-items: center;
        padding-top: 0;
    }

    .product-title-fixed {
        height: 44px;
        min-height: 44px;
        max-height: 44px;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        line-height: 1.35;
        font-size: 15px;
        text-align: center;
        width: 100%;
        margin-bottom: 6px;
    }

    .product-brand-fixed {
        height: 20px;
        min-height: 20px;
        max-height: 20px;
        overflow: hidden;
        font-size: 13px;
        text-align: center;
        width: 100%;
        margin-bottom: 8px;
        color: #6c757d;
    }

    .product-stock-fixed {
        height: 34px;
        min-height: 34px;
        max-height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        margin-bottom: 8px;
    }

    .product-price-fixed {
        height: 36px;
        min-height: 36px;
        max-height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        margin-bottom: 12px;
        font-size: 18px;
    }

    .product-actions {
        margin-top: auto;
        width: 100%;
    }

        .product-actions .btn {
            font-weight: 600;
            padding: 9px 12px;
            font-size: 14px;
        }

    .page-header-box {
        background: white;
        border-radius: 24px;
        padding: 24px 28px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.04);
        margin-bottom: 24px;
    }

    .filter-title {
        font-size: 15px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 14px;
    }

    .brand-check {
        margin-bottom: 10px;
    }

    .stock-badge-custom {
        min-width: 90px;
        text-align: center;
        font-size: 12px;
        font-weight: 600;
        padding: 8px 14px;
        border-radius: 999px;
    }

    .products-grid .col-xl-3,
    .products-grid .col-lg-4,
    .products-grid .col-md-6 {
        display: flex;
    }

    @@media (max-width: 991px) {
        .product-image-wrapper {
            height: 170px;
        }
    }

    @@media (max-width: 767px) {
        .product-image-wrapper {
            height: 160px;
        }

        .product-title-fixed {
            font-size: 14px;
        }

        .product-price-fixed {
            font-size: 17px;
        }
    }

    .sort-box {
        display: flex;
        justify-content: flex-end;
    }

    .sort-select {
        width: 220px;
        padding: 12px 18px;
        border: 1px solid #e5e5e5;
        border-radius: 14px;
        background: #fff;
        font-weight: 600;
        outline: none;
        box-shadow: 0 8px 20px rgba(0,0,0,.04);
        transition: .2s;
    }

        .sort-select:focus {
            border-color: #111;
        }
</style>

<div class="page-header-box">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <h1 class="fw-bold mb-2">“@Model.Search” için sonuçlar</h1>
                <p class="text-muted mb-0">@Model.Products.Count ürün bulundu.</p>
            }
            else if (Model.SelectedCategoryIds != null && Model.SelectedCategoryIds.Any())
            {
                <h1 class="fw-bold mb-2">Filtrelenmiş Ürünler</h1>
                <p class="text-muted mb-0">@Model.Products.Count ürün bulundu.</p>
            }
            else
            {
                <h1 class="fw-bold mb-2">Ürünler</h1>
                <p class="text-muted mb-0">@Model.Products.Count ürün bulundu.</p>
            }
        </div>

        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark rounded-4 px-4">
            <i class="fa-solid fa-arrow-left me-2"></i> Ana Sayfaya Dön
        </a>
    </div>
</div>
<div class="sort-box mb-4">
    <form method="get">

        <select name="sort"
                class="sort-select"
                onchange="this.form.submit()">

            <option value="">Sıralama</option>
            <option value="price_asc">Fiyat Artan</option>
            <option value="price_desc">Fiyat Azalan</option>
            <option value="az">A-Z</option>
            <option value="za">Z-A</option>
            <option value="new">En Yeni</option>

        </select>

    </form>
</div>
<div class="row g-4">
    <div class="col-lg-3">
        <button class="btn btn-dark w-100 rounded-3 mb-3 filter-toggle-btn align-items-center justify-content-between"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#filterCollapse"
                aria-expanded="false"
                aria-controls="filterCollapse">
            <span><i class="fa-solid fa-filter me-2"></i> Filtrele</span>
            <i class="fa-solid fa-chevron-down"></i>
        </button>

        <div class="collapse" id="filterCollapse">
        <div class="card filter-card p-4">
            <form method="get" asp-controller="Product" asp-action="Index">

                <div class="mb-4">
                    <h5 class="filter-title">Kategoriler</h5>

                    @foreach (var category in Model.Categories)
                    {
                        <div class="form-check brand-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="categoryId"
                                   value="@category.ID"
                                   id="cat_@category.ID"
                                   checked="@(selectedCategoryIds.Contains(category.ID))" />

                            <label class="form-check-label" for="cat_@category.ID">
                                @category.CategoryName
                            </label>
                        </div>
                    }
                </div>

                <div class="mb-4">
                    <h5 class="filter-title">Markalar</h5>

                    @foreach (var brand in Model.Brands)
                    {
                        <div class="form-check brand-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="brands"
                                   value="@brand"
                                   id="brand_@brand"
                                   checked="@(selectedBrands.Contains(brand))" />

                            <label class="form-check-label" for="brand_@brand">
                                @brand
                            </label>
                        </div>
                    }
                </div>

                <div class="mb-4">
                    <h5 class="filter-title">Fiyat Aralığı</h5>

                    <input type="number"
                           name="minPrice"
                           class="form-control mb-2 rounded-3"
                           placeholder="Min ₺"
                           value="@Model.MinPrice" />

                    <input type="number"
                           name="maxPrice"
                           class="form-control rounded-3"
                           placeholder="Max ₺"
                           value="@Model.MaxPrice" />
                </div>

                <input type="hidden" name="search" value="@Model.Search" />

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-dark rounded-3">
                        <i class="fa-solid fa-filter me-2"></i> Filtrele
                    </button>

                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary rounded-3">
                        Temizle
                    </a>
                </div>
            </form>
        </div>
        </div>
        </div>

    <div class="col-lg-9">
        <div class="row g-4 products-grid">
            @if (Model.Products != null && Model.Products.Count > 0)
            {
                @foreach (var item in Model.Products)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6">
                        <div class="card product-card-custom w-100 p-3">

                            <div class="product-image-wrapper">
                                <img src="~/images/@item.ProductImage"
                                     class="product-img-custom"
                                     alt="@item.ProductName"
                                     onerror="this.src='/images/products/default.svg'" />
                            </div>

                            <div class="card-body px-1 product-card-body">

                                <h6 class="fw-bold product-title-fixed">
                                    @item.ProductName
                                </h6>

                                <p class="product-brand-fixed">
                                    @item.ProductBrand
                                </p>

                                <div class="product-stock-fixed">
                                    @if (item.ProductStock > 0)
                                    {
                                        <span class="badge bg-light text-dark border stock-badge-custom">
                                            Stokta Var
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary stock-badge-custom">
                                            Tükendi
                                        </span>
                                    }
                                </div>

                                <h5 class="fw-bold text-dark product-price-fixed">
                                    @item.ProductPrice ₺
                                </h5>

                                <div class="d-grid gap-2 product-actions">
                                    <a asp-controller="Product"
                                       asp-action="Detail"
                                       asp-route-id="@item.ID"
                                       class="btn btn-dark rounded-3">
                                        <i class="fa-solid fa-eye me-2"></i> İncele
                                    </a>

                                    @if (item.ProductStock > 0)
                                    {
                                        <a asp-controller="Cart"
                                           asp-action="AddToCart"
                                           asp-route-id="@item.ID"
                                           class="btn btn-outline-warning rounded-3">
                                            <i class="fa-solid fa-cart-shopping me-2"></i> Sepete Ekle
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary rounded-3" disabled>
                                            Stokta Yok
                                        </button>
                                    }
                                </div>

                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-warning rounded-4 shadow-sm">
                        Bu filtreye uygun ürün bulunamadı.
                    </div>
                </div>
            }
        </div>
    </div>
</div>