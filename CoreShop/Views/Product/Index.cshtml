@model CoreShop.Models.ProductPageVM

@{
    ViewData["Title"] = "Ürünler";
    var selectedCategoryIds = Model.SelectedCategoryIds;
    var selectedBrands = Model.SelectedBrands;
    var currentSort = Model.Sort;
}

<div class="page-head">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <h1 class="h3 mb-1">“@Model.Search” için sonuçlar</h1>
            }
            else if (selectedCategoryIds.Any() || selectedBrands.Any() || Model.MinPrice.HasValue || Model.MaxPrice.HasValue)
            {
                <h1 class="h3 mb-1">Filtrelenmiş Ürünler</h1>
            }
            else
            {
                <h1 class="h3 mb-1">Tüm Ürünler</h1>
            }
            <p class="text-muted mb-0">@Model.Products.Count ürün listeleniyor</p>
        </div>

        <form method="get" asp-controller="Product" asp-action="Index" aria-label="Sıralama">
            @* Keep every active filter when the sort changes *@
            <input type="hidden" name="search" value="@Model.Search" />
            <input type="hidden" name="minPrice" value="@Model.MinPrice" />
            <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />
            @foreach (var id in selectedCategoryIds)
            {
                <input type="hidden" name="categoryId" value="@id" />
            }
            @foreach (var brand in selectedBrands)
            {
                <input type="hidden" name="brands" value="@brand" />
            }

            <select name="sort" class="form-select sort-select" onchange="this.form.submit()" aria-label="Sıralama seç">
                <option value="" selected="@string.IsNullOrEmpty(currentSort)">Önerilen Sıralama</option>
                <option value="price_asc" selected="@(currentSort == "price_asc")">Fiyat: Düşükten Yükseğe</option>
                <option value="price_desc" selected="@(currentSort == "price_desc")">Fiyat: Yüksekten Düşüğe</option>
                <option value="az" selected="@(currentSort == "az")">İsim: A–Z</option>
                <option value="za" selected="@(currentSort == "za")">İsim: Z–A</option>
                <option value="new" selected="@(currentSort == "new")">En Yeni</option>
            </select>
        </form>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-3">
        <button class="btn btn-dark w-100 mb-3 filter-toggle-btn align-items-center justify-content-between"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#filterCollapse"
                aria-expanded="false"
                aria-controls="filterCollapse">
            <span><i class="fa-solid fa-filter me-2" aria-hidden="true"></i> Filtrele</span>
            <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        </button>

        <div class="collapse" id="filterCollapse">
            <div class="filter-panel p-4">
                <form method="get" asp-controller="Product" asp-action="Index" aria-label="Ürün filtreleri">

                    <div class="mb-4">
                        <h2 class="filter-title">Kategoriler</h2>

                        @foreach (var category in Model.Categories)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="categoryId"
                                       value="@category.ID"
                                       id="cat_@category.ID"
                                       checked="@(selectedCategoryIds.Contains(category.ID))" />

                                <label class="form-check-label" for="cat_@category.ID">
                                    @category.CategoryName
                                </label>
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <h2 class="filter-title">Markalar</h2>

                        @foreach (var brand in Model.Brands)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="brands"
                                       value="@brand"
                                       id="brand_@brand.Replace(" ", "_")"
                                       checked="@(selectedBrands.Contains(brand))" />

                                <label class="form-check-label" for="brand_@brand.Replace(" ", "_")">
                                    @brand
                                </label>
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <h2 class="filter-title">Fiyat Aralığı</h2>

                        <label class="visually-hidden" for="minPrice">En düşük fiyat</label>
                        <input type="number"
                               id="minPrice"
                               name="minPrice"
                               min="0"
                               class="form-control mb-2"
                               placeholder="Min ₺"
                               value="@Model.MinPrice" />

                        <label class="visually-hidden" for="maxPrice">En yüksek fiyat</label>
                        <input type="number"
                               id="maxPrice"
                               name="maxPrice"
                               min="0"
                               class="form-control"
                               placeholder="Max ₺"
                               value="@Model.MaxPrice" />
                    </div>

                    @* Keep search and sort when the filters change *@
                    <input type="hidden" name="search" value="@Model.Search" />
                    <input type="hidden" name="sort" value="@currentSort" />

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-brand">
                            <i class="fa-solid fa-filter me-2" aria-hidden="true"></i> Uygula
                        </button>

                        <a asp-controller="Product" asp-action="Index" class="btn btn-soft">
                            Temizle
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-9">
        <div class="row g-4 products-grid">
            @if (Model.Products.Any())
            {
                @foreach (var item in Model.Products)
                {
                    <div class="col-xl-4 col-lg-6 col-md-6">
                        <partial name="_ProductCard" model="item" />
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        </div>
                        <h4>Sonuç bulunamadı</h4>
                        <p>Bu filtrelere uyan ürün yok. Filtreleri temizleyip tekrar deneyebilirsin.</p>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-brand">
                            Filtreleri Temizle
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
