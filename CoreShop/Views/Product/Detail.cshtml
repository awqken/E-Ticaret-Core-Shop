@model CoreShop.Models.ProductDetailVM

@{
    ViewData["Title"] = "Ürün Detay";
}

<style>
    .detail-page-wrapper {
        min-height: 80vh;
    }
    .detail-card {
        border: none;
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.06);
        overflow: hidden;
    }

    .product-img-big {
        width: 100%;
        height: 400px;
        object-fit: cover;
    }

    .price-box {
        font-size: 28px;
        font-weight: 700;
        color: #111827;
    }

    .stock-badge {
        padding: 6px 12px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 600;
    }

    .in-stock {
        background-color: #dcfce7;
        color: #15803d;
    }

    .out-stock {
        background-color: #fee2e2;
        color: #b91c1c;
    }
</style>

<div class="container py-4 detail-page-wrapper">

    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-dark mb-4 rounded-3">
        <i class="fa-solid fa-arrow-left me-2"></i> Geri
    </a>

    <div class="card detail-card p-4">
        <div class="row g-4">

            <div class="col-lg-6">
                <img src="~/images/@Model.Product.ProductImage"
                     class="product-img-big rounded-4"
                     alt="@Model.Product.ProductName"
                     onerror="this.src='/images/products/default.svg'" />
            </div>

            <div class="col-lg-6 d-flex flex-column justify-content-between">

                <div>
                    <h2 class="fw-bold mb-2">@Model.Product.ProductName</h2>

                    <p class="text-muted mb-3">
                        <i class="fa-solid fa-tag me-2"></i> @Model.Product.ProductBrand
                    </p>

                    <div class="price-box mb-3">
                        @Model.Product.ProductPrice ₺
                    </div>

                    @if (Model.Product.ProductStock > 0)
                    {
                        <span class="stock-badge in-stock">
                            Stokta var (@Model.Product.ProductStock adet)
                        </span>
                    }
                    else
                    {
                        <span class="stock-badge out-stock">
                            Stokta yok
                        </span>
                    }

                    <hr class="my-4" />

                    <h5 class="fw-bold mb-2">Ürün Açıklaması</h5>
                    <p class="text-muted">
                        @Model.Product.Description
                    </p>
                </div>

                @if (Model.Product.ProductStock > 0)
                {
                    <form asp-controller="Cart" asp-action="AddToCart" asp-route-id="@Model.Product.ID" method="post" class="d-grid">
                        <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                        <button type="submit" class="btn btn-warning btn-lg w-100 rounded-4 fw-semibold">
                            <i class="fa-solid fa-cart-shopping me-2"></i> Sepete Ekle
                        </button>
                    </form>
                }
                else
                {
                    <button class="btn btn-secondary btn-lg w-100 rounded-4 fw-semibold" disabled>
                        <i class="fa-solid fa-ban me-2"></i> Stokta Yok
                    </button>
                }
                

            </div>
        </div>
    </div>

    @if (Model.RelatedProducts != null && Model.RelatedProducts.Count > 0)
    {
        <div class="mt-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold mb-1">Önerilen Ürünler</h3>
                    <p class="text-muted mb-0">İlginizi çekebilecek diğer ürünlere de göz atabilirsiniz.</p>
                </div>
            </div>

            <div class="row g-4">
                @foreach (var item in Model.RelatedProducts)
                {
                    <div class="col-lg-3 col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                            <img src="~/images/@item.ProductImage"
                                 class="card-img-top rounded-4 mb-3"
                                 style="height:220px; object-fit:cover;"
                                 alt="@item.ProductName"
                                 onerror="this.src='/images/products/default.svg'" />

                            <div class="card-body px-1">
                                <h5 class="fw-bold">@item.ProductName</h5>
                                <p class="text-muted mb-2">@item.ProductBrand</p>

                                <h4 class="fw-bold text-dark mb-3">@item.ProductPrice ₺</h4>

                                <div class="d-grid gap-2">
                                    <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.ID"
                                       class="btn btn-dark rounded-3">
                                        <i class="fa-solid fa-eye me-2"></i> İncele
                                    </a>

                                    <form asp-controller="Cart" asp-action="AddToCart" asp-route-id="@item.ID" method="post" class="d-grid">
                                        <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                        <button type="submit" class="btn btn-outline-warning rounded-3">
                                            <i class="fa-solid fa-cart-shopping me-2"></i> Sepete Ekle
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>