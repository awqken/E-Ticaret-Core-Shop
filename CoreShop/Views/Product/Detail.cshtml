@model CoreShop.Models.ProductDetailVM

@{
    ViewData["Title"] = Model.Product.ProductName;
}

<nav aria-label="Sayfa yolu">
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
        <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Ürünler</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Product.ProductName</li>
    </ol>
</nav>

<div class="surface p-4 p-lg-5">
    <div class="row g-4 g-lg-5">

        <div class="col-lg-6">
            <div class="detail-media">
                <img src="~/images/@Model.Product.ProductImage"
                     alt="@Model.Product.ProductName"
                     width="520" height="380"
                     onerror="this.src='/images/products/default.svg'" />
            </div>
        </div>

        <div class="col-lg-6 d-flex flex-column">

            <div class="product-brand mb-1">@Model.Product.ProductBrand</div>

            <h1 class="h2 mb-3">@Model.Product.ProductName</h1>

            <div class="d-flex align-items-center gap-3 flex-wrap mb-3">
                <div class="detail-price">@Model.Product.ProductPrice.ToTryPrice()</div>

                @if (Model.Product.ProductStock > 5)
                {
                    <span class="stock-pill badge-soft-success">
                        <i class="fa-solid fa-circle-check" aria-hidden="true"></i> Stokta var
                    </span>
                }
                else if (Model.Product.ProductStock > 0)
                {
                    <span class="stock-pill badge-soft-warning">
                        <i class="fa-solid fa-hourglass-half" aria-hidden="true"></i> Son @Model.Product.ProductStock adet
                    </span>
                }
                else
                {
                    <span class="stock-pill badge-soft-danger">
                        <i class="fa-solid fa-circle-xmark" aria-hidden="true"></i> Stokta yok
                    </span>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.Product.Description))
            {
                <h2 class="h6 fw-bold mt-2 mb-2">Ürün Açıklaması</h2>
                <p class="text-muted mb-4">@Model.Product.Description</p>
            }

            <div class="mt-auto">
                @if (Model.Product.ProductStock > 0)
                {
                    <form asp-controller="Cart" asp-action="AddToCart" asp-route-id="@Model.Product.ID" method="post" class="d-grid">
                        <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                        <button type="submit" class="btn btn-brand btn-lg">
                            <i class="fa-solid fa-cart-plus me-2" aria-hidden="true"></i> Sepete Ekle
                        </button>
                    </form>
                }
                else
                {
                    <button type="button" class="btn btn-soft btn-lg w-100" disabled>
                        <i class="fa-solid fa-ban me-2" aria-hidden="true"></i> Stokta Yok
                    </button>
                }
            </div>

        </div>
    </div>
</div>

@if (Model.RelatedProducts.Any())
{
    <section class="mt-5" aria-label="Önerilen ürünler">
        <div class="section-head">
            <div class="section-eyebrow mb-1">Benzer Ürünler</div>
            <h2 class="h3 mb-1">Bunlar da ilgini çekebilir</h2>
        </div>

        <div class="row g-4 products-grid">
            @foreach (var item in Model.RelatedProducts)
            {
                <div class="col-lg-3 col-md-6">
                    <partial name="_ProductCard" model="item" />
                </div>
            }
        </div>
    </section>
}
