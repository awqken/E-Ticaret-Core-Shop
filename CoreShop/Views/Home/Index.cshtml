@using CoreShop.Helpers
@model CoreShop.Models.HomePageVM

@{
    ViewData["Title"] = "CoreShop — Premium Teknoloji & Donanım Mağazası";

    static string CategoryIcon(string categoryName) => categoryName.ToLower() switch
    {
        var name when name.Contains("işlemci") => "fa-microchip",
        var name when name.Contains("ekran") => "fa-tv",
        var name when name.Contains("ram") => "fa-memory",
        var name when name.Contains("ssd") || name.Contains("hdd") => "fa-hard-drive",
        var name when name.Contains("anakart") => "fa-server",
        var name when name.Contains("monitör") || name.Contains("monitor") => "fa-desktop",
        var name when name.Contains("güç") => "fa-plug",
        var name when name.Contains("kasa") => "fa-computer",
        var name when name.Contains("soğutma") => "fa-fan",
        _ => "fa-box"
    };
}

@* ── Apple Keynote Launch Style Hero Reveal Section ─────── *@
<partial name="_HeroCampaign" model="Model" />

@* ── Category Ecosystem Pills ──────────────────────────────────── *@
<section id="categories" class="py-5" aria-label="Donanım Ekosistemi">
    <div class="text-center mb-4">
        <span class="text-secondary fw-semibold small text-uppercase tracking-widest d-block mb-1">Kategoriler</span>
        <h2 class="awwwards-section-title text-black fw-bold m-0">Donanım Ekosistemi.</h2>
    </div>

    <div class="d-flex flex-wrap align-items-center justify-content-center gap-2.5 py-3">
        @foreach (var category in Model.Categories.Take(10))
        {
            <a asp-controller="Product"
               asp-action="Index"
               asp-route-categoryIdSingle="@category.ID"
               class="awwwards-cat-pill px-4 py-2.5 rounded-pill bg-subtle-gray text-dark text-decoration-none fw-semibold d-inline-flex align-items-center gap-2">
                <i class="fa-solid @CategoryIcon(category.CategoryName) text-muted fs-6"></i>
                <span>@category.CategoryName</span>
            </a>
        }
    </div>
</section>

@* ── Borderless Bento Showcase Tiles ──────────────────────────────────── *@
<section id="collections" class="my-5" aria-label="Koleksiyonlar">
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="awwwards-bento-card p-5 rounded-5 bg-subtle-gray text-start position-relative overflow-hidden border-0">
                <span class="text-secondary fw-semibold small text-uppercase mb-2 d-block">Masaüstü Mimarisi</span>
                <h3 class="fw-bold text-black display-6 mb-2">Sessiz ve Güçlü.</h3>
                <p class="text-muted mb-4 max-w-sm">Yüksek hava akışlı kasalar ve sıvı soğutma mimarisi.</p>
                <a asp-controller="Product" asp-action="Index" asp-route-categoryIdSingle="8" class="btn btn-black-pill rounded-pill px-4 py-2 text-white text-decoration-none">
                    İnceleyin &rsaquo;
                </a>
                <div class="mt-4 pt-2 text-end">
                    <img src="~/images/products/fractal-north.png" alt="Kasa ve Soğutma" class="img-fluid awwwards-bento-img" />
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="awwwards-bento-card p-5 rounded-5 bg-subtle-gray text-start position-relative overflow-hidden border-0">
                <span class="text-secondary fw-semibold small text-uppercase mb-2 d-block">Grafik Mimarisi</span>
                <h3 class="fw-bold text-black display-6 mb-2">RTX 40 Serisi.</h3>
                <p class="text-muted mb-4 max-w-sm">DLSS 3 ve Yapay Zeka destekli raytracing kartları.</p>
                <a asp-controller="Product" asp-action="Index" asp-route-categoryIdSingle="2" class="btn btn-gray-pill rounded-pill px-4 py-2 text-dark text-decoration-none">
                    İnceleyin &rsaquo;
                </a>
                <div class="mt-4 pt-2 text-end">
                    <img src="~/images/products/rtx-4070-super.png" alt="RTX 4070" class="img-fluid awwwards-bento-img" />
                </div>
            </div>
        </div>
    </div>
</section>

@* ── Featured Products E-Commerce Showcase (3-Column Minimalist Grid) ─────────────── *@
@if (Model.FeaturedProducts.Any())
{
    <section id="products" class="my-6 py-4" aria-label="Seçkin Donanımlar">
        <div class="d-flex align-items-end justify-content-between mb-4">
            <div>
                <span class="text-secondary fw-semibold small text-uppercase tracking-widest d-block mb-1">Seçkin Donanımlar</span>
                <h2 class="awwwards-section-title text-black fw-bold m-0">Öne Çıkan Ürünler.</h2>
            </div>
            <a asp-controller="Product" asp-action="Index" class="text-black text-decoration-none fw-semibold fs-6">
                Tümünü Gör &rsaquo;
            </a>
        </div>

        <div class="row g-4 products-grid">
            @foreach (var item in Model.FeaturedProducts.Take(6))
            {
                <div class="col-lg-4 col-md-6">
                    <partial name="_ProductCard" model="item" />
                </div>
            }
        </div>
    </section>
}

@* ── Minimal Service Guarantees ────────────────────────────────────────── *@
<section id="guarantees" class="my-5 py-5 px-4 rounded-5 bg-subtle-gray text-center border-0" aria-label="Hizmet Garantileri">
    <div class="row g-4 text-muted small text-center align-items-center">
        <div class="col-md-3 col-6">
            <i class="fa-solid fa-bolt text-black fs-4 mb-2 d-block"></i>
            <strong class="text-black d-block">Stoktan Hızlı Kargo</strong>
            <span class="text-muted">Aynı gün sevk</span>
        </div>
        <div class="col-md-3 col-6">
            <i class="fa-solid fa-shield-halved text-black fs-4 mb-2 d-block"></i>
            <strong class="text-black d-block">%100 Orijinal</strong>
            <span class="text-muted">Distribütör garantili</span>
        </div>
        <div class="col-md-3 col-6">
            <i class="fa-solid fa-rotate-left text-black fs-4 mb-2 d-block"></i>
            <strong class="text-black d-block">14 Gün İade</strong>
            <span class="text-muted">Şeffaf süreç</span>
        </div>
        <div class="col-md-3 col-6">
            <i class="fa-solid fa-headset text-black fs-4 mb-2 d-block"></i>
            <strong class="text-black d-block">Canlı Destek</strong>
            <span class="text-muted">Teknik danışmanlık</span>
        </div>
    </div>
</section>













