@model CoreShop.Models.HomePageVM

@{
    ViewData["Title"] = "Ana Sayfa";
}

<section class="hero p-4 p-md-5 mb-4" aria-label="Tanıtım">
    <div class="row align-items-center">
        <div class="col-lg-7 py-lg-4">
            <span class="hero-eyebrow mb-3">
                <i class="fa-solid fa-bolt" aria-hidden="true"></i> Yeni nesil donanım mağazası
            </span>

            <h1 class="display-5 mt-3 mb-3">
                Hayalindeki sistemi<br />
                <span class="hero-highlight">CoreShop</span> ile kur.
            </h1>

            <p class="lead-text mb-4">
                İşlemciden ekran kartına, RAM'den monitöre — en güncel bilgisayar
                bileşenlerini uygun fiyatlarla keşfet.
            </p>

            <div class="d-flex flex-wrap gap-3">
                <a asp-controller="Product" asp-action="Index" class="btn btn-brand btn-lg">
                    <i class="fa-solid fa-store me-2" aria-hidden="true"></i> Alışverişe Başla
                </a>

                <a href="#categories" class="btn btn-outline-light btn-lg">
                    Kategorileri İncele
                </a>
            </div>
        </div>

        <div class="col-lg-5 mt-4 mt-lg-0">
            <div class="row g-3">
                <div class="col-6">
                    <div class="hero-panel p-4 text-center h-100">
                        <i class="fa-solid fa-microchip fa-2x mb-3" aria-hidden="true"></i>
                        <h6 class="text-white fw-bold mb-1">İşlemci</h6>
                        <small>Güçlü performans</small>
                    </div>
                </div>

                <div class="col-6">
                    <div class="hero-panel p-4 text-center h-100">
                        <i class="fa-solid fa-tv fa-2x mb-3" aria-hidden="true"></i>
                        <h6 class="text-white fw-bold mb-1">Ekran Kartı</h6>
                        <small>Yüksek grafik gücü</small>
                    </div>
                </div>

                <div class="col-6">
                    <div class="hero-panel p-4 text-center h-100">
                        <i class="fa-solid fa-memory fa-2x mb-3" aria-hidden="true"></i>
                        <h6 class="text-white fw-bold mb-1">RAM</h6>
                        <small>Akıcı kullanım</small>
                    </div>
                </div>

                <div class="col-6">
                    <div class="hero-panel p-4 text-center h-100">
                        <i class="fa-solid fa-hard-drive fa-2x mb-3" aria-hidden="true"></i>
                        <h6 class="text-white fw-bold mb-1">SSD</h6>
                        <small>Hızlı depolama</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="surface mb-5" aria-label="Neden CoreShop">
    <div class="row g-0">
        <div class="col-lg-3 col-md-6">
            <div class="trust-item">
                <div class="trust-icon"><i class="fa-solid fa-truck-fast" aria-hidden="true"></i></div>
                <div>
                    <strong>Hızlı Teslimat</strong>
                    <small>Siparişin hemen yola çıkar</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="trust-item">
                <div class="trust-icon"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></div>
                <div>
                    <strong>Güvenli Ödeme</strong>
                    <small>Bilgilerin koruma altında</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="trust-item">
                <div class="trust-icon"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></div>
                <div>
                    <strong>Kolay İade</strong>
                    <small>14 gün içinde ücretsiz</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="trust-item">
                <div class="trust-icon"><i class="fa-solid fa-headset" aria-hidden="true"></i></div>
                <div>
                    <strong>7/24 Destek</strong>
                    <small>Her zaman yanındayız</small>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="categories" class="mb-5" aria-label="Kategoriler">
    <div class="section-head">
        <div class="section-eyebrow mb-1">Keşfet</div>
        <h2 class="mb-1">Popüler Kategoriler</h2>
        <p>İlgini çeken kategoriye hızlıca geç.</p>
    </div>

    <div class="row g-3">
        @foreach (var category in Model.Categories.Take(6))
        {
            var categoryName = category.CategoryName.ToLower();
            var icon = categoryName switch
            {
                var name when name.Contains("işlemci") => "fa-microchip",
                var name when name.Contains("ekran") => "fa-tv",
                var name when name.Contains("ram") => "fa-memory",
                var name when name.Contains("ssd") || name.Contains("hdd") => "fa-hard-drive",
                var name when name.Contains("anakart") => "fa-server",
                var name when name.Contains("monitör") || name.Contains("monitor") => "fa-desktop",
                var name when name.Contains("güç") => "fa-plug",
                var name when name.Contains("kasa") => "fa-computer",
                var name when name.Contains("soğutma") => "fa-fan",
                _ => "fa-box"
            };

            <div class="col-md-2 col-4">
                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-categoryIdSingle="@category.ID"
                   class="text-decoration-none"
                   aria-label="@category.CategoryName kategorisine git">
                    <div class="category-card">
                        <div class="category-icon">
                            <i class="fa-solid @icon" aria-hidden="true"></i>
                        </div>
                        <h6>@category.CategoryName</h6>
                    </div>
                </a>
            </div>
        }
    </div>
</section>

<section aria-label="Öne çıkan ürünler">
    <div class="section-head">
        <div class="section-eyebrow mb-1">Vitrin</div>
        <h2 class="mb-1">Öne Çıkan Ürünler</h2>
        <p>Son eklenen teknoloji ürünleri burada.</p>
    </div>

    <div class="row g-4 products-grid">
        @if (Model.Products.Any())
        {
            @foreach (var item in Model.Products)
            {
                <div class="col-lg-3 col-md-6">
                    <partial name="_ProductCard" model="item" />
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                    </div>
                    <h4>Henüz ürün yok</h4>
                    <p>Mağazaya ürün eklendiğinde burada görünecek.</p>
                </div>
            </div>
        }
    </div>

    <div class="text-center mt-5">
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-brand btn-lg px-5">
            Tüm Ürünleri Gör <i class="fa-solid fa-arrow-right ms-2" aria-hidden="true"></i>
        </a>
    </div>
</section>
