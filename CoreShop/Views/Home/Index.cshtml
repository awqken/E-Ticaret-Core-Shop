@model CoreShop.Models.HomePageVM

@{
    ViewData["Title"] = "Ana Sayfa";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .product-card-custom {
        border: none;
        border-radius: 20px;
        transition: all 0.25s ease;
        box-shadow: 0 6px 20px rgba(0,0,0,0.05);
        height: 100%;
    }

        .product-card-custom:hover {
            transform: translateY(-6px);
            box-shadow: 0 14px 30px rgba(0,0,0,0.08);
        }

    .product-img-custom {
        height: 220px;
        width: 100%;
        object-fit: contain;
        background-color: #f8f9fa;
        border-radius: 16px;
        padding: 12px;
    }

    .product-card-body {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .product-title-fixed {
        min-height: 48px;
        max-height: 48px;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        line-height: 1.4;
    }

    .product-brand-fixed {
        min-height: 24px;
    }

    .product-price-fixed {
        min-height: 38px;
    }

    .product-actions {
        margin-top: auto;
    }

    .category-box {
        transition: all 0.25s ease;
        cursor: pointer;
    }

        .category-box:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08) !important;
        }

    .product-card-custom {
        transition: all 0.25s ease;
    }

        .product-card-custom:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.08) !important;
        }

    .product-img-custom {
        height: 220px;
        object-fit: cover;
        border-radius: 16px;
    }

    .section-title {
        font-weight: 700;
        color: #111827;
    }
</style>


<div class="p-4 p-md-5 rounded-4 shadow-sm mb-5 bg-white border">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <span class="badge bg-dark text-white px-3 py-2 rounded-pill mb-3">
                CoreShop
            </span>

            <h1 class="fw-bold display-6 mb-3 text-dark">
                Yüksek Performanslı Bilgisayar Bileşenleri
            </h1>

            <p class="text-muted fs-5 mb-4" style="max-width: 600px;">
                En güncel donanım ürünlerini uygun fiyatlarla keşfedin.
            </p>

            <div class="d-flex flex-wrap gap-3">
                <a asp-controller="Product" asp-action="Index" class="btn btn-dark btn-lg rounded-4 px-4">
                    <i class="fa-solid fa-store me-2"></i> Alışverişe Başla
                </a>

                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-dark btn-lg rounded-4 px-4">
                    <i class="fa-solid fa-list me-2"></i> Kategorileri İncele
                </a>
            </div>
        </div>

        <div class="col-lg-5 mt-4 mt-lg-0">
            <div class="row g-3">
                <div class="col-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100">
                        <i class="fa-solid fa-microchip fa-2x text-warning mb-3"></i>
                        <h6 class="fw-bold mb-1">İşlemci</h6>
                        <small class="text-muted">Güçlü performans</small>
                    </div>
                </div>

                <div class="col-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100">
                        <i class="fa-solid fa-tv fa-2x text-primary mb-3"></i>
                        <h6 class="fw-bold mb-1">Ekran Kartı</h6>
                        <small class="text-muted">Yüksek grafik gücü</small>
                    </div>
                </div>

                <div class="col-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100">
                        <i class="fa-solid fa-memory fa-2x text-danger mb-3"></i>
                        <h6 class="fw-bold mb-1">RAM</h6>
                        <small class="text-muted">Hızlı kullanım</small>
                    </div>
                </div>

                <div class="col-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100">
                        <i class="fa-solid fa-hard-drive fa-2x text-success mb-3"></i>
                        <h6 class="fw-bold mb-1">SSD</h6>
                        <small class="text-muted">Hızlı depolama</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="section-title mb-1">Popüler Kategoriler</h3>
            <p class="text-muted mb-0">İlgini çeken kategoriye hızlıca geç.</p>
        </div>
    </div>

    <div class="row g-3">
        @if (Model.Categories != null && Model.Categories.Count > 0)
        {
            @foreach (var category in Model.Categories.Take(6))
            {
                var categoryName = category.CategoryName.ToLower();
                string icon = "fa-box";
                string color = "text-dark";

                if (categoryName.Contains("işlemci"))
                {
                    icon = "fa-microchip";
                    color = "text-warning";
                }
                else if (categoryName.Contains("ram"))
                {
                    icon = "fa-memory";
                    color = "text-danger";
                }
                else if (categoryName.Contains("ssd"))
                {
                    icon = "fa-hard-drive";
                    color = "text-success";
                }
                else if (categoryName.Contains("anakart"))
                {
                    icon = "fa-server";
                    color = "text-secondary";
                }
                else if (categoryName.Contains("monitör") || categoryName.Contains("monitor"))
                {
                    icon = "fa-desktop";
                    color = "text-info";
                }

                <div class="col-md-2 col-6">
                    <a asp-controller="Product"
                       asp-action="Index"
                       asp-route-categoryId="@category.ID"
                       class="text-decoration-none">
                        <div class="card border-0 shadow-sm rounded-4 text-center p-4 h-100 category-box">
                            <i class="fa-solid @icon fa-2x @color mb-3"></i>
                            <h6 class="fw-bold mb-0 text-dark">@category.CategoryName</h6>
                        </div>
                    </a>
                </div>
            }
        }
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="section-title mb-1">Öne Çıkan Ürünler</h2>
        <p class="text-muted mb-0">Son eklenen teknoloji ürünleri burada.</p>
    </div>
</div>

<div class="row g-4">
    @if (Model.Products != null && Model.Products.Count > 0)
    {
        @foreach (var item in Model.Products)
        {
            <div class="col-lg-3 col-md-6">
                <div class="card product-card-custom h-100 p-3">

                    <div class="product-image-wrapper">
                        <img src="~/images/@item.ProductImage"
                             class="card-img-top product-img-custom mb-3"
                             alt="@item.ProductName"
                             onerror="this.src='/images/products/default.svg'" />
                    </div>

                    <div class="card-body px-1 product-card-body">
                        <h6 class="fw-bold product-title-fixed">@item.ProductName</h6>
                        <p class="text-muted mb-2 small product-brand-fixed">@item.ProductBrand</p>

                        <h5 class="fw-bold text-dark mb-3 product-price-fixed">@item.ProductPrice ₺</h5>

                        <div class="d-grid gap-2 product-actions">
                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.ID"
                               class="btn btn-dark rounded-3">
                                <i class="fa-solid fa-eye me-2"></i> İncele
                            </a>

                            @if (item.ProductStock > 0)
                            {
                                <form asp-controller="Cart" asp-action="AddToCart" asp-route-id="@item.ID" method="post" class="d-grid">
                                    <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                    <button type="submit" class="btn btn-outline-warning rounded-3">
                                        <i class="fa-solid fa-cart-shopping me-2"></i> Sepete Ekle
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-secondary rounded-3" disabled>
                                    Stokta Yok
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-primary rounded-4 shadow-sm">
                Henüz ürün eklenmemiş.
            </div>
        </div>
    }
</div>

<div class="text-center mt-5">
    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-dark btn-lg rounded-4 px-5 fw-semibold">
        <i class="fa-solid fa-arrow-right me-2"></i> Daha Fazlasını Gör
    </a>
</div>