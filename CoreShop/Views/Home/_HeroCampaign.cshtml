@using CoreShop.Helpers
@model CoreShop.Models.HomePageVM

@{
    var campaign = Model.Campaign;
    var product = Model.HeroProduct;

    var isLight = campaign.Layout == HeroLayout.LightStudio;
    var stageClass = isLight ? "hero-light" : "hero-dark";
    var accentClass = $"hero-accent-{campaign.Accent.ToString().ToLowerInvariant()}";

    var primaryBtn = isLight ? "btn-brand" : "btn-light fw-semibold";
    var secondaryBtn = isLight ? "btn-outline-dark" : "btn-outline-light";
}

<section class="hero-stage @stageClass @accentClass full-bleed" aria-label="Kampanya: @campaign.Kicker">
    <div class="container">
        <div class="row align-items-center g-4 g-lg-5">
            <div class="col-lg-6">
                <p class="hero-kicker">@campaign.Kicker</p>

                <h1 class="hero-title">
                    @campaign.HeadlineTop<br />
                    @campaign.HeadlineBottom
                </h1>

                <p class="hero-sub">@campaign.Subtitle</p>

                <div class="d-flex flex-wrap gap-3 mt-4">
                    @if (campaign.CtaCategoryId is int categoryId)
                    {
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryIdSingle="@categoryId"
                           class="btn btn-lg @primaryBtn">
                            @campaign.CtaText
                        </a>

                        <a asp-controller="Product" asp-action="Index" class="btn btn-lg @secondaryBtn">
                            Tüm Ürünler
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Product" asp-action="Index" class="btn btn-lg @primaryBtn">
                            @campaign.CtaText
                        </a>

                        <a href="#categories" class="btn btn-lg @secondaryBtn">
                            Kategorilere Göz At
                        </a>
                    }
                </div>

                <p class="hero-note">@campaign.Note</p>
            </div>

            <div class="col-lg-6">
                @if (campaign.Layout == HeroLayout.DarkTypography)
                {
                    @if (campaign.SpecChips.Any())
                    {
                        <ul class="hero-spec-panel list-unstyled" aria-label="Öne çıkan özellikler">
                            @foreach (var spec in campaign.SpecChips)
                            {
                                <li class="hero-spec">
                                    <i class="fa-solid fa-check" aria-hidden="true"></i>
                                    <span>@spec</span>
                                </li>
                            }
                        </ul>
                    }
                }
                else if (product != null)
                {
                    <div class="hero-scene">
                        <img src="~/images/@product.ProductImage"
                             alt="@product.ProductName"
                             width="443" height="450"
                             fetchpriority="high"
                             onerror="this.src='/images/products/default.svg'" />
                    </div>
                }

                @if (product != null)
                {
                    <a asp-controller="Product" asp-action="Detail" asp-route-id="@product.ID"
                       class="hero-scene-caption">
                        <span>
                            <span class="caption-name">@product.ProductName</span>
                            <span class="caption-meta d-block">
                                @product.ProductBrand · @(product.ProductStock > 0 ? "Stokta" : "Stok bekleniyor")
                            </span>
                        </span>

                        <span class="d-inline-flex align-items-center gap-2">
                            <span class="caption-price">@product.ProductPrice.ToTryPrice()</span>
                            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                        </span>
                    </a>
                }
            </div>
        </div>
    </div>
</section>
